prefix=/usr
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: gbm
Description: Mali GBM library
# rockchip's template says 10.4.0; the blob has the GBM API SDL2's
# KMSDRM driver needs (it checks for >= 11.1.0), so that is declared.
Version: 11.1.0
Libs: -L${libdir} -lgbm
Libs.private: -lm -lpthread
Cflags: -I${includedir}
