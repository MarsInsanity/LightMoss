config BR2_PACKAGE_RK3326_MALI
	bool "rk3326-mali"
	depends on BR2_aarch64
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_USES_GLIBC
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_HAS_LIBEGL
	select BR2_PACKAGE_HAS_LIBGLES
	select BR2_PACKAGE_HAS_LIBGBM
	select BR2_PACKAGE_LIBGBM_HAS_FEATURE_DMA_BUF
	select BR2_PACKAGE_LIBDRM
	help
	  The Mali-G31 (Bifrost) user-space blob for the RK3326 on the
	  rg351 4.4 kernel: libmali-bifrost-g31-rxp0-gbm.so from
	  christianhaitian/rk3326_core_builds, the build that matches
	  that kernel's r12p0 kbase driver (rockchip's newer libmali
	  does not). Provides EGL, GLES 1/2/3 and GBM; the headers are
	  rockchip's libmali ones.

	  Unlike buildroot's rockchip-mali, this does not build an
	  out-of-tree kbase module: the kernel has its own.

if BR2_PACKAGE_RK3326_MALI

config BR2_PACKAGE_PROVIDES_LIBEGL
	default "rk3326-mali"

config BR2_PACKAGE_PROVIDES_LIBGLES
	default "rk3326-mali"

config BR2_PACKAGE_PROVIDES_LIBGBM
	default "rk3326-mali"

endif

comment "rk3326-mali needs an aarch64 glibc toolchain w/ C++, threads"
	depends on BR2_aarch64
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_USES_GLIBC || \
		!BR2_TOOLCHAIN_HAS_THREADS
