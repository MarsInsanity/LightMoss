#!/bin/sh
# LightMoss (R36S): the Mali user-space blob that matches the running
# kernel's GPU driver. The 4.4 kernel's r12p0 kbase needs the rxp0 blob the
# image installs; the BSP 5.10 kernel's g29p1 kbase needs the g29p1 blob,
# which also has Vulkan. Programs reach the blob through rxp0's file
# (libmali.so.1, libEGL.so.1, libGLESv2.so.2, libgbm.so.1 ... are links to
# it), so on 5.10 g29p1 is bind-mounted over that file, 64- and 32-bit, and
# the Vulkan loader is given g29p1's ICD manifest (/etc/vulkan/icd.d/mali.json
# links to it). Nothing on the root file system changes: on 4.4 this does
# nothing, and the mounts go with the boot.
set -u

case "$(uname -r)" in
5.10.*) ;;
*) exit 0 ;;
esac

bind() {
	src=$1 dst=$2
	if [ ! -f "$src" ] || [ ! -f "$dst" ]; then
		echo "mali-select: $src or $dst is missing" >&2
		return 1
	fi
	# once per boot (a oneshot unit): nothing is mounted here before
	grep -q " $dst " /proc/self/mountinfo || mount --bind "$src" "$dst"
}

rc=0
bind /usr/lib/mali-g29p1/libmali-bifrost-g31-g29p1.so \
	/usr/lib/libmali-bifrost-g31-rxp0-gbm.so || rc=1
bind /usr/lib/arm-linux-gnueabihf/mali-g29p1/libmali-bifrost-g31-g29p1.so \
	/usr/lib/arm-linux-gnueabihf/libmali-bifrost-g31-rxp0-gbm.so || rc=1

mkdir -p /run/lightmoss
cat > /run/lightmoss/mali_icd.json <<'ICD'
{
    "file_format_version": "1.0.0",
    "ICD": {
        "library_path": "/usr/lib/libmali.so.1",
        "api_version": "1.3.276"
    }
}
ICD
exit $rc
