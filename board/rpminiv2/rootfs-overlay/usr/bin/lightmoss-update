#!/bin/sh
# Update LightMoss on the internal storage from a release image, while it
# runs: lightmoss-update [-y] lightmoss-rpminiv2-<version>.img.xz
#
# The image's system goes on the system copy that is not running (LMSYS2
# when this is LMSYS1, and back), which is then made OpenABL's default with
# three tries: the next start boots it. Once spruce starts on it,
# lightmoss-bless keeps it. If it never gets that far, OpenABL boots this
# copy again after three tries, and lightmoss-bless puts it back as the
# default and leaves /boot/lightmoss-update-failed for the update app.
#
# The running copy is never written, so a power cut or a bad image at any
# point leaves the device starting as before. Kept from the running copy: the
# machine ID and the SSH host keys (the flags on LMBOOT stay where they are).
set -eu
. /usr/libexec/lightmoss/lib.sh

die() { echo "lightmoss-update: $*" >&2; exit 1; }

yes=0
[ "${1:-}" = -y ] && { yes=1; shift; }
img="${1:-}"
[ -n "$img" ] && [ -f "$img" ] || die "usage: lightmoss-update [-y] lightmoss-rpminiv2-<version>.img.xz"

slot="$(lm_slot)"
case "$slot" in
	1) new=2 ;;
	2) new=1 ;;
	*) die "this system does not run from the internal storage (system copy $slot): install it first (lightmoss-install-internal)" ;;
esac
disk="$(lm_root_disk)"
target="$(lm_part_named "$disk" "LMSYS$new")" || die "no LMSYS$new partition"
mountpoint -q /boot || die "LMBOOT is not mounted at /boot"
grep -q "/dev/${target#/dev/} " /proc/mounts && die "$target is mounted"

echo "Checking $img..."
xz -t "$img" 2>/dev/null || die "the image is damaged (xz check failed)"

# The image's GPT (512-byte sectors, as genimage writes it): the LMSYS
# partition's first and last sector, from its 128-byte entries at LBA 2.
hdr="$(mktemp)"
trap 'rm -f "$hdr" "$hdr.fifo" "$hdr.sum" "$hdr.dd"' EXIT
xz -dc "$img" 2>/dev/null | head -c 65536 > "$hdr" || true
[ "$(dd if="$hdr" bs=1 skip=512 count=8 2>/dev/null)" = "EFI PART" ] || die "the image has no GPT"
first=""; last=""
i=0
while [ "$i" -lt 128 ]; do
	off=$(( 1024 + i * 128 ))
	name="$(dd if="$hdr" bs=1 skip=$(( off + 56 )) count=72 2>/dev/null | tr -d '\000')"
	if [ "$name" = LMSYS ]; then
		first="$(od -An -tu8 -j $(( off + 32 )) -N 8 "$hdr" | tr -d ' ')"
		last="$(od -An -tu8 -j $(( off + 40 )) -N 8 "$hdr" | tr -d ' ')"
		break
	fi
	i=$((i + 1))
done
[ -n "$first" ] && [ -n "$last" ] || die "the image has no LMSYS partition: not a LightMoss image for this device"
skip=$(( first * 512 ))
bytes=$(( (last - first + 1) * 512 ))
have=$(( $(cat "/sys/class/block/${target#/dev/}/size") * 512 ))
[ "$bytes" -le "$have" ] || die "the image's system ($bytes bytes) does not fit LMSYS$new ($have bytes)"

if [ "$yes" = 0 ]; then
	echo "This writes the image's system to system copy $new ($target) and makes it"
	echo "the one the next start boots. The running copy ($slot) stays as it is."
	printf 'Type "yes" to continue: '
	read -r answer
	[ "$answer" = yes ] || die "cancelled"
fi

echo "Writing system copy $new..."
# One pass: the system goes to the partition while its checksum is taken.
mkfifo "$hdr.fifo"
sha256sum < "$hdr.fifo" | cut -d' ' -f1 > "$hdr.sum" &
sumpid=$!
xz -dc "$img" | tail -c +$(( skip + 1 )) | head -c "$bytes" | tee "$hdr.fifo" | dd of="$target" bs=1M conv=fsync 2>"$hdr.dd" ||
	die "writing $target failed"
wait "$sumpid"
want="$(cat "$hdr.sum")"
wrote="$(sed -n 's/^\([0-9][0-9]*\) bytes.*/\1/p' "$hdr.dd" | tail -n 1)"
[ "$wrote" = "$bytes" ] || die "only ${wrote:-0} of the system's $bytes bytes were written: not installed"
echo "Checking what was written..."
echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
got="$(head -c "$bytes" "$target" | sha256sum | cut -d' ' -f1)"
[ -n "$want" ] && [ "$got" = "$want" ] || die "system copy $new does not read back as written: not installed"

e2fsck -fy "$target" >/dev/null 2>&1 || true
resize2fs "$target" >/dev/null 2>&1 || true

mnt="$(mktemp -d)"
trap 'umount "$mnt" 2>/dev/null; rmdir "$mnt" 2>/dev/null; rm -f "$hdr" "$hdr.fifo" "$hdr.sum" "$hdr.dd"' EXIT
mount "$target" "$mnt" || die "cannot mount $target"
version="$(sed -n 's/^LIGHTMOSS_VERSION="\(.*\)"/\1/p' "$mnt/usr/lib/os-release" 2>/dev/null)"
[ -d "$mnt/usr/share/lightmoss/boot" ] || die "the new system has no boot files"
# This system's identity, in the new copy.
cp -a /etc/machine-id "$mnt/etc/machine-id" 2>/dev/null || true
if [ -d /etc/dropbear ]; then
	rm -rf "$mnt/etc/dropbear"
	cp -a /etc/dropbear "$mnt/etc/dropbear"
fi
mkdir -p "$mnt/var/lib/lightmoss"
touch "$mnt/var/lib/lightmoss/firstboot.done"

echo "Setting up the boot entry..."
rm -rf "/boot/lightmoss-$new"
mkdir -p "/boot/lightmoss-$new"
cp "$mnt"/usr/share/lightmoss/boot/* "/boot/lightmoss-$new/"
umount "$mnt"
partuuid="$(blkid -o value -s PARTUUID "$target")"
[ -n "$partuuid" ] || die "$target has no PARTUUID"
mkdir -p /boot/loader/entries
rm -f /boot/loader/entries/lightmoss-"$new".conf /boot/loader/entries/lightmoss-"$new"+*.conf
# Three tries: OpenABL counts them down; lightmoss-bless keeps the entry once
# spruce has started on it.
/usr/libexec/lightmoss/boot-entry "$new" "$partuuid" "$version" > "/boot/loader/entries/lightmoss-$new+3.conf"
printf 'default lightmoss-%s.conf\ntimeout 0\n' "$new" > /boot/loader/loader.conf.new
mv -f /boot/loader/loader.conf.new /boot/loader/loader.conf
echo "$version" > /boot/lightmoss-update-pending
rm -f /boot/lightmoss-update-failed
sync
echo "Done: LightMoss $version is on system copy $new and starts next time."
