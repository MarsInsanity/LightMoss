[Unit]
Description=Keep this system copy's boot entry once spruce is up
# The internal storage's system copies only; a card has nothing to keep.
ConditionKernelCommandLine=|lightmoss.slot=1
ConditionKernelCommandLine=|lightmoss.slot=2
After=spruce-launch.service lightmoss-boot.service
Requires=lightmoss-boot.service

[Service]
# Started, not waited for: on a trial start it waits for spruce itself (up to
# 10 minutes), and the boot (multi-user.target) does not wait for that.
Type=exec
ExecStart=/usr/libexec/lightmoss/bless

[Install]
WantedBy=multi-user.target
