[Unit]
Description=Hand off to spruce
# As soon as what spruce needs is there, not after the whole boot
# (multi-user.target, then Type=idle's wait for every other job cost about a
# second): LMBOOT and the devices (basic.target, implied), the mixer restored
# and the sound card set up, SPRUCEOS on a first boot, and NetworkManager on D-Bus,
# since spruce's startup runs nmcli. mount-spruce waits for the card itself;
# there is no mount unit for it.
After=local-fs.target systemd-udev-trigger.service alsa-restore.service alsa-state.service
After=lightmoss-audio.service lightmoss-volkeys.service NetworkManager.service lightmoss-firstboot.service lightmoss-install-internal.service
# lightmoss-audio is a oneshot: spruce opens hw:0,0 only once it is routed.
Wants=lightmoss-audio.service

[Service]
Type=simple
# spruce runs as root and does its own mounts and hardware access. Its scripts
# use $HOME (ALSA's ~/.asoundrc, among others).
Environment=HOME=/root

# Kill only runtime.sh on stop, not the whole cgroup: spruce powers off from
# save_poweroff.sh, a descendant of runtime.sh that kills runtime.sh on its way
# past. With the default KillMode=control-group systemd would then kill
# save_poweroff.sh too, before it reaches the poweroff. What stays behind is
# ended by spruce-leftovers: here, before a restart starts a second spruce
# beside the first one's watchdogs, and at shutdown by
# lightmoss-spruce-leftovers.service, before the card is unmounted.
KillMode=process
ExecStartPre=-/usr/libexec/lightmoss/spruce-leftovers 3
ExecStartPre=/usr/libexec/lightmoss/mount-spruce
# The LightMoss Update app onto the card; never in the way of the frontend.
ExecStartPre=-/usr/libexec/lightmoss/spruce-app
# Cosmetic, so a failure must not stop the frontend (the leading dash).
ExecStartPre=-/usr/libexec/lightmoss/console-blank
# runtime.sh is spruce's own entry point. SIGHUP is ignored before the exec and
# stays ignored in everything spruce starts: TTYVHangup below hangs up tty1
# when this unit stops, which would otherwise kill a running game before it
# saves. So are the terminal's other signals: tty1 is spruce's controlling
# terminal, and Ctrl+C, Ctrl+\ or Ctrl+Z typed on a USB or Bluetooth keyboard
# while no SDL program holds the keyboard would end or stop spruce for good
# (death by SIGINT counts as a clean exit, so no restart). spruce never sends
# these three itself, and programs that want Ctrl+C (RetroArch) install their
# own handler.
# The output goes to the journal; with /boot/lightmoss-debug,
# lightmoss-debug-console.service also shows it on the screen.
ExecStart=/bin/sh -c 'trap "" HUP INT QUIT TSTP; exec /mnt/SDCARD/spruce/scripts/runtime.sh'
Restart=on-failure
RestartSec=3
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
