#!/bin/sh
# lightmoss-install-internal.service: the card's boot partition holds
#   lightmoss-install          install LightMoss on the internal storage, or
#                              repair the install there;
#   lightmoss-install-replace  the same, removing another system's partitions
#                              behind Android's userdata first (ROCKNIX's, say).
# (Either may end in .txt, as a PC may name it.) With the charger connected,
# run lightmoss-install-internal and restart into the internal storage; the
# flag is renamed .done (or .failed, with the reason in lightmoss-install.log
# next to it) so it runs once. Without the charger it says so and the card
# starts as usual.
LM_ROOT="${LM_ROOT:-}"
# shellcheck source=lib.sh
. "$LM_ROOT/usr/libexec/lightmoss/lib.sh"
B="$LM_ROOT/boot"

case "$(lm_disk_type "$(lm_root_disk)")" in SD) ;; *) exit 0 ;; esac
flag=""
for f in lightmoss-install lightmoss-install.txt lightmoss-install-replace lightmoss-install-replace.txt; do
	[ -e "$B/$f" ] && { flag="$B/$f"; break; }
done
[ -n "$flag" ] || exit 0
name="${flag%.txt}"
case "$name" in
	*-replace) replace=--replace ;;
	*) replace="" ;;
esac

if ! lm_charger_online; then
	lm_say "LightMoss can be installed on the internal storage:\n  connect the charger and restart.\n\n  Starting from the card for now..."
	sleep 6
	exit 0
fi

lm_say "Installing LightMoss on the internal storage...\n\n  Keep the charger connected and do not power off."
# shellcheck disable=SC2086 # $replace: one option or none
if "$LM_ROOT/usr/bin/lightmoss-install-internal" --from-flag $replace > "$B/lightmoss-install.log" 2>&1; then
	mv -f "$flag" "$name.done"
	sync
	msg="LightMoss is on the internal storage."
	if grep -q "^Android's data was cleared" "$B/lightmoss-install.log"; then
		msg="$msg\n\n  Android's data was cleared: Android sets\n  itself up again on its next start."
	fi
	lm_say "$msg\n\n  Restarting into LightMoss..."
	sleep 8
	systemctl reboot
	sleep 60
else
	mv -f "$flag" "$name.failed"
	sync
	why="$(sed -n 's/^lightmoss-install-internal: //p' "$B/lightmoss-install.log" | tail -n 1)"
	[ -n "$why" ] || why="$(tail -n 1 "$B/lightmoss-install.log")"
	lm_say "The install did not complete:\n\n  $why\n\n  (lightmoss-install.log on the card). Starting from the card..."
	sleep 12
fi
exit 0
