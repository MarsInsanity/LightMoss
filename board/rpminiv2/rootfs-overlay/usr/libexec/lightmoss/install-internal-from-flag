#!/bin/sh
# lightmoss-install-internal.service: the card's boot partition holds
# lightmoss-install. With the charger connected, install LightMoss on the
# internal storage and restart into it; the flag is renamed .done (or .failed,
# with the reason in lightmoss-install.log next to it) so it runs once.
# Without the charger it says so and the card starts as usual.
. /usr/libexec/lightmoss/lib.sh

case "$(lm_disk_type "$(lm_root_disk)")" in SD) ;; *) exit 0 ;; esac
flag=""
for f in /boot/lightmoss-install /boot/lightmoss-install.txt; do
	[ -e "$f" ] && { flag="$f"; break; }
done
[ -n "$flag" ] || exit 0

if ! lm_charger_online; then
	lm_say "LightMoss can be installed on the internal storage:\n  connect the charger and restart.\n\n  Starting from the card for now..."
	sleep 6
	exit 0
fi

lm_say "Installing LightMoss on the internal storage...\n\n  Keep the charger connected and do not power off."
if /usr/bin/lightmoss-install-internal --from-flag > /boot/lightmoss-install.log 2>&1; then
	mv -f "$flag" "/boot/lightmoss-install.done"
	sync
	lm_say "LightMoss is on the internal storage.\n\n  Android formats its data on its next start.\n\n  Restarting into LightMoss..."
	sleep 8
	systemctl reboot
	sleep 60
else
	mv -f "$flag" "/boot/lightmoss-install.failed"
	sync
	lm_say "The install did not complete:\n\n  $(tail -n 1 /boot/lightmoss-install.log)\n\n  (lightmoss-install.log on the card). Starting from the card..."
	sleep 12
fi
exit 0
