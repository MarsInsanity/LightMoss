#!/bin/sh
# Mount spruce at /mnt/SDCARD, where spruce expects to find itself.
#
# Where spruce can be, first match wins (the one that has
# spruce/scripts/runtime.sh is spruce):
#   1. a FAT32/exFAT partition of the card, when the system is not on it:
#      partition 1 of a card formatted for spruce, or the SPRUCEOS partition
#      of the LightMoss card this system was installed from;
#   2. the SPRUCEOS partition behind the system on the card it runs from
#      (lightmoss-firstboot made it).
# The internal storage is never searched: its FAT partitions are Android's.
# None after a retry: say so on the screen and power off.
. /usr/libexec/lightmoss/lib.sh

candidates() {
	root_disk="$(lm_root_disk)"
	for d in /sys/block/mmcblk*; do
		[ -e "$d" ] || continue
		disk="${d##*/}"
		case "$disk" in *boot*|*rpmb*) continue ;; esac
		if [ "$disk" != "$root_disk" ]; then
			for p in "$d/$disk"*; do
				[ -e "$p/partition" ] || continue
				[ "$(lm_part_name "${p##*/}")" = LMBOOT ] && continue
				case "$(blkid -o value -s TYPE "/dev/${p##*/}" 2>/dev/null)" in
					vfat|exfat) echo "/dev/${p##*/}" ;;
				esac
			done
		else
			lm_part_named "$disk" SPRUCEOS
		fi
	done
}

mount_spruce() {
	mountpoint -q /mnt/SDCARD && [ -f /mnt/SDCARD/spruce/scripts/runtime.sh ] && return 0
	for dev in $(candidates); do
		mount -o rw,noatime,umask=0000 "$dev" /mnt/SDCARD 2>/dev/null || continue
		if [ -f /mnt/SDCARD/spruce/scripts/runtime.sh ]; then
			echo "spruce found on $dev"
			return 0
		fi
		umount /mnt/SDCARD
	done
	return 1
}

mkdir -p /mnt/SDCARD
mount_spruce && exit 0

lm_say "Looking for the spruce card..."
sleep 5
if mount_spruce; then
	printf '\033[2J\033[H' > /dev/tty1 2>/dev/null
	exit 0
fi

lm_say "spruce card not found, shutting down"
echo "spruce card not found, powering off" >&2
sleep 3
systemctl poweroff
sleep 60
exit 1
