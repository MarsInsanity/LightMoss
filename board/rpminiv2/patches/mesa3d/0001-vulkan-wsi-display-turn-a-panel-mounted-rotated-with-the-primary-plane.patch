+/* The mode's size as applications see it: sides swapped on a panel turned by
+ * 90 or 270 degrees (LightMoss). hdisplay and vdisplay stay the CRTC's.
+ */
+static uint32_t
+wsi_display_mode_width(const struct wsi_display_mode *mode)
+{
+   return mode->connector->rot_swap ? mode->vdisplay : mode->hdisplay;
+}
+
+static uint32_t
+wsi_display_mode_height(const struct wsi_display_mode *mode)
+{
+   return mode->connector->rot_swap ? mode->hdisplay : mode->vdisplay;
+}
