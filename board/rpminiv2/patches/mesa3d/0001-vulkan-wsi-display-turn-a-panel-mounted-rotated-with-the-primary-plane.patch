+    * CRTC's primary plane. rot_value is the plane's DRM_MODE_ROTATE_* value,
+    * 0 when nothing is turned; rot_swap shows the modes with their sides
+    * swapped (90 and 270); rot_on is set while this instance has turned the
+    * plane.
+    */
+   bool                         rot_probed;
+   bool                         rot_swap;
+   bool                         rot_on;
+   uint64_t                     rot_value;
+   uint32_t                     rot_crtc_id;
+   uint32_t                     rot_plane_id;
+   uint32_t                     rot_prop_id;
 } wsi_display_connector;
 
