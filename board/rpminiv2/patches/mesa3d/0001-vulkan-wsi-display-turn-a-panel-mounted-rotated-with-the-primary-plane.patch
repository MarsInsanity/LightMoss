 wsi_display_mode_matches_drm(wsi_display_mode *wsi,
                              drmModeModeInfoPtr drm)
@@ -276,6 +305,322 @@
 }
 
 /*
+ * Panel rotation (LightMoss).
+ *
+ * A panel mounted rotated reports it in its connector's "panel orientation"
+ * property (from the device tree's "rotation"). The kernel's console turns
+ * its text to match; nothing turns what a KMS/DRM program shows, so
+ * VK_KHR_display presented sideways on such a panel. Where the CRTC's
+ * primary plane can rotate (a "rotation" property offering the angle), turn
+ * it, the way the kernel's fbdev emulation would for 0 and 180 degrees:
+ * Left Side Up -> 90, Upside Down -> 180, Right Side Up -> 270. For 90 and
+ * 270 the display's modes, plane capabilities and surface extents are shown
+ * with their sides swapped, applications render into images of that size,
+ * and the plane scans them out turned: the kernel's legacy drmModeSetCrtc()
+ * and drmModePageFlip() swap the source size of a primary plane turned by 90
+ * or 270 degrees.
+ *
+ * The plane is turned with drmModeObjectSetProperty() right before each
+ * drmModeSetCrtc() (DRM master needed), and turned upright again once the
+ * CRTC no longer shows one of our images (the swapchain's framebuffers are
+ * removed, which disables the plane), so the next program finds it as it
+ * was; the kernel's fbdev restore also resets it. A plane that refuses
+ * is set upright and leaves the display unturned and its sides unswapped
+ * from then on: the swapchain made for the swapped size is out of date,
+ * and the application's next one is not turned.
+ *
+ * MESA_KMS_PANEL_ROTATION overrides it: "0" leaves the panel alone, "90",
+ * "180" or "270" turns the plane by that many degrees (counter-clockwise,
+ * as DRM counts) whatever the connector says. On displays without a "panel
+ * orientation", or one that says Normal, nothing changes.
+ */
+#ifndef DRM_MODE_ROTATE_0
+#define DRM_MODE_ROTATE_0   (1 << 0)
+#define DRM_MODE_ROTATE_90  (1 << 1)
+#define DRM_MODE_ROTATE_180 (1 << 2)
+#define DRM_MODE_ROTATE_270 (1 << 3)
+#endif
+#ifndef DRM_PLANE_TYPE_PRIMARY
+#define DRM_PLANE_TYPE_PRIMARY 1
+#endif
+#ifndef DRM_CLIENT_CAP_UNIVERSAL_PLANES
+#define DRM_CLIENT_CAP_UNIVERSAL_PLANES 2
+#endif
+
+/* The rotation the panel wants: a DRM_MODE_ROTATE_* value, or 0 to leave it
+ * alone.
+ */
+static uint64_t
+wsi_display_panel_rotation_wanted(int fd, drmModeConnectorPtr drm_connector)
+{
+   const char *env = getenv("MESA_KMS_PANEL_ROTATION");
+   uint64_t rotation = 0;
+
+   if (env && *env) {
+      switch (atoi(env)) {
+      case 90:  return DRM_MODE_ROTATE_90;
+      case 180: return DRM_MODE_ROTATE_180;
+      case 270: return DRM_MODE_ROTATE_270;
+      default:  return 0;
+      }
+   }
+
+   for (int p = 0; p < drm_connector->count_props; p++) {
+      drmModePropertyPtr prop = drmModeGetProperty(fd, drm_connector->props[p]);
+      if (!prop)
+         continue;
+      if (!strcmp(prop->name, "panel orientation") &&
+          (prop->flags & DRM_MODE_PROP_ENUM)) {
+         for (int e = 0; e < prop->count_enums; e++) {
+            if (prop->enums[e].value != drm_connector->prop_values[p])
+               continue;
+            if (!strcmp(prop->enums[e].name, "Upside Down"))
+               rotation = DRM_MODE_ROTATE_180;
+            else if (!strcmp(prop->enums[e].name, "Left Side Up"))
+               rotation = DRM_MODE_ROTATE_90;
+            else if (!strcmp(prop->enums[e].name, "Right Side Up"))
+               rotation = DRM_MODE_ROTATE_270;
+         }
+      }
+      drmModeFreeProperty(prop);
+   }
+   return rotation;
+}
+
+/* The CRTC's own primary plane: the one legacy drmModeSetCrtc() and
+ * drmModePageFlip() scan out from. Every plane may list every CRTC as
+ * possible (MSM's DPU does), so the first compatible primary plane is not
+ * necessarily it. In order: the primary plane bound to the CRTC now, else
+ * the crtc_index-th primary plane (drivers create one primary per CRTC, in
+ * CRTC order), else the first primary plane that can be used with it.
+ * *rot_prop is that plane's "rotation" property if it offers the rotation,
+ * else 0. Returns 0 when there is no primary plane at all.
+ */
+static uint32_t
+wsi_display_crtc_primary_plane(int fd, drmModeResPtr mode_res,
+                               uint32_t crtc_id, uint64_t rotation,
+                               uint32_t *rot_prop)
+{
+   uint32_t found[3] = { 0, 0, 0 };     /* bound, by index, first compatible */
+   uint32_t found_rot[3] = { 0, 0, 0 };
+   int crtc_index = -1, primary_index = 0, rot_bit = 0;
+
+   *rot_prop = 0;
+   for (int c = 0; c < mode_res->count_crtcs; c++) {
+      if (mode_res->crtcs[c] == crtc_id) {
+         crtc_index = c;
+         break;
+      }
+   }
+   if (crtc_index < 0)
+      return 0;
+
+   /* The bit of the rotation in the property's bitmask. */
+   while (rot_bit < 4 && !(rotation & (1ull << rot_bit)))
+      rot_bit++;
+
+   drmSetClientCap(fd, DRM_CLIENT_CAP_UNIVERSAL_PLANES, 1);
+   drmModePlaneResPtr planes = drmModeGetPlaneResources(fd);
+   if (!planes)
+      return 0;
+
+   for (uint32_t i = 0; i < planes->count_planes && !found[0]; i++) {
+      drmModePlanePtr plane = drmModeGetPlane(fd, planes->planes[i]);
+      if (!plane)
+         continue;
+
+      bool primary = false;
+      uint32_t rot = 0;
+      drmModeObjectPropertiesPtr props =
+         drmModeObjectGetProperties(fd, plane->plane_id, DRM_MODE_OBJECT_PLANE);
+      for (uint32_t k = 0; props && k < props->count_props; k++) {
+         drmModePropertyPtr prop = drmModeGetProperty(fd, props->props[k]);
+         if (!prop)
+            continue;
+         if (!strcmp(prop->name, "type")) {
+            primary = props->prop_values[k] == DRM_PLANE_TYPE_PRIMARY;
+         } else if (!strcmp(prop->name, "rotation") &&
+                    (prop->flags & DRM_MODE_PROP_BITMASK)) {
+            for (int e = 0; e < prop->count_enums; e++) {
+               if (prop->enums[e].value == (uint64_t) rot_bit)
+                  rot = prop->prop_id;
+            }
+         }
+         drmModeFreeProperty(prop);
+      }
+      drmModeFreeObjectProperties(props);
+
+      if (primary) {
+         const bool compatible = (plane->possible_crtcs & (1u << crtc_index)) != 0;
+         if (plane->crtc_id == crtc_id) {
+            found[0] = plane->plane_id;
+            found_rot[0] = rot;
+         }
+         if (primary_index == crtc_index && compatible && !found[1]) {
+            found[1] = plane->plane_id;
+            found_rot[1] = rot;
+         }
+         if (compatible && !found[2]) {
+            found[2] = plane->plane_id;
+            found_rot[2] = rot;
+         }
+         primary_index++;
+      }
+      drmModeFreePlane(plane);
+   }
+   drmModeFreePlaneResources(planes);
+
+   for (int j = 0; j < 3; j++) {
+      if (found[j]) {
+         *rot_prop = found_rot[j];
+         return found[j];
+      }
+   }
+   return 0;
+}
+
+/* Decides once per connector whether its panel is turned, which shows its
+ * modes with their sides swapped for 90 and 270: when the panel wants a
+ * rotation and the primary plane of the CRTC driving it now (or of the first
+ * CRTC it can use) offers it.
+ */
+static void
+wsi_display_probe_panel_rotation(int fd,
+                                 struct wsi_display_connector *connector,
+                                 drmModeConnectorPtr drm_connector)
+{
+   uint64_t rotation = wsi_display_panel_rotation_wanted(fd, drm_connector);
+   if (!rotation)
+      return;
+
+   drmModeResPtr mode_res = drmModeGetResources(fd);
+   if (!mode_res)
+      return;
+
+   uint32_t crtc_id = 0;
+   if (drm_connector->encoder_id) {
+      drmModeEncoderPtr encoder = drmModeGetEncoder(fd, drm_connector->encoder_id);
+      if (encoder) {
+         crtc_id = encoder->crtc_id;
+         drmModeFreeEncoder(encoder);
+      }
+   }
+   for (int e = 0; !crtc_id && e < drm_connector->count_encoders; e++) {
+      drmModeEncoderPtr encoder = drmModeGetEncoder(fd, drm_connector->encoders[e]);
+      if (!encoder)
+         continue;
+      for (int c = 0; !crtc_id && c < mode_res->count_crtcs; c++) {
+         if (encoder->possible_crtcs & (1u << c))
+            crtc_id = mode_res->crtcs[c];
+      }
+      drmModeFreeEncoder(encoder);
+   }
+
+   uint32_t rot_prop = 0;
+   uint32_t plane_id = crtc_id ?
+      wsi_display_crtc_primary_plane(fd, mode_res, crtc_id, rotation, &rot_prop) : 0;
+   drmModeFreeResources(mode_res);
+
+   if (!plane_id || !rot_prop) {
+      mesa_logw("display: the panel is mounted rotated, but its CRTC's "
+                "primary plane cannot turn it; presenting it unturned");
+      return;
+   }
+
+   connector->rot_value = rotation;
+   connector->rot_swap = rotation == DRM_MODE_ROTATE_90 ||
+                         rotation == DRM_MODE_ROTATE_270;
+}
+
+/* Turns the primary plane of the connector's CRTC, right before
+ * drmModeSetCrtc(). A plane that refuses (other than for want of DRM master)
+ * leaves the panel unturned and its sides unswapped from then on, and is set
+ * upright, in case an earlier mode set turned it. Returns false when that
+ * swapped the display's sides back: the swapchain's images, made for the
+ * swapped size, no longer fit the CRTC's mode.
+ */
+static bool
+wsi_display_turn_panel(struct wsi_display *wsi,
+                       struct wsi_display_connector *connector)
+{
+   if (!connector->rot_value)
+      return true;
+
+   if (!connector->rot_plane_id || connector->rot_crtc_id != connector->crtc_id) {
+      drmModeResPtr mode_res = drmModeGetResources(wsi->fd);
+      if (!mode_res)
+         return true;
+      connector->rot_plane_id =
+         wsi_display_crtc_primary_plane(wsi->fd, mode_res, connector->crtc_id,
+                                        connector->rot_value,
+                                        &connector->rot_prop_id);
+      connector->rot_crtc_id = connector->crtc_id;
+      drmModeFreeResources(mode_res);
+   }
+
+   int ret = -EINVAL;
+   if (connector->rot_plane_id && connector->rot_prop_id) {
+      drmSetClientCap(wsi->fd, DRM_CLIENT_CAP_UNIVERSAL_PLANES, 1);
+      ret = drmModeObjectSetProperty(wsi->fd, connector->rot_plane_id,
+                                     DRM_MODE_OBJECT_PLANE,
+                                     connector->rot_prop_id,
+                                     connector->rot_value);
+   }
+   if (ret == 0) {
+      if (!connector->rot_on) {
+         mesa_logi("display: panel mounted rotated, turned by plane %u "
+                   "(rotation 0x%x)", connector->rot_plane_id,
+                   (unsigned) connector->rot_value);
+      }
+      connector->rot_on = true;
+      return true;
+   }
+   if (ret == -EACCES)
+      return true;
+
+   mesa_logw("display: could not turn the panel's plane (%s); presenting "
+             "it unturned", strerror(-ret));
+   if (connector->rot_plane_id && connector->rot_prop_id) {
+      drmModeObjectSetProperty(wsi->fd, connector->rot_plane_id,
+                               DRM_MODE_OBJECT_PLANE, connector->rot_prop_id,
+                               DRM_MODE_ROTATE_0);
+   }
+   const bool swapped = connector->rot_swap;
+   connector->rot_value = 0;
+   connector->rot_swap = false;
+   connector->rot_on = false;
+   return !swapped;
+}
+
+/* Turns the plane upright again once the CRTC shows nothing of ours: the
+ * images' framebuffers are gone, which disabled the plane (a swapchain that
+ * replaced this one keeps it turned). The next present then sets the CRTC
+ * again, which turns the plane first, rather than flipping a CRTC that has
+ * no framebuffer.
+ */
+static void
+wsi_display_unturn_panel(struct wsi_display *wsi,
+                         struct wsi_display_connector *connector)
+{
+   if (!connector->rot_on || wsi->fd < 0)
+      return;
+
+   drmModeCrtcPtr crtc = drmModeGetCrtc(wsi->fd, connector->crtc_id);
+   bool showing = crtc && crtc->buffer_id != 0;
+   drmModeFreeCrtc(crtc);
+   if (showing)
+      return;
+
+   drmSetClientCap(wsi->fd, DRM_CLIENT_CAP_UNIVERSAL_PLANES, 1);
+   drmModeObjectSetProperty(wsi->fd, connector->rot_plane_id,
+                            DRM_MODE_OBJECT_PLANE, connector->rot_prop_id,
+                            DRM_MODE_ROTATE_0);
+   connector->rot_on = false;
+   /* The next present sets the CRTC again, turning the plane first. */
+   connector->active = false;
+}
+
+/*
  * Update our information about a specific connector
  */
 
