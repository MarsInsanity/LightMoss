From: LightMoss <noreply@github.com>
Subject: [PATCH] kmsdrm: turn a panel mounted rotated with the primary plane

The Retroid Pocket Mini V2's AMOLED panel scans out portrait (1080x1240)
and is mounted landscape; its device tree says so ("rotation = <90>"),
which the kernel reports as the connector's "panel orientation" (Right
Side Up). The kernel's console turns its text to match; nothing turns
what a KMS/DRM program shows, so every SDL program came out sideways.

Where the CRTC's primary plane can rotate (with ROCKNIX's SDE rotator
patches the SM8250's planes offer 90 and 270), turn it by the panel's
orientation, as the kernel's fbdev emulation does for 0 and 180, and
show SDL programs the display with its sides swapped (1240x1080): they
render into buffers of that size, which the plane scans out turned.
The plane is turned upright again before the console's CRTC
configuration is restored, so the next program finds it as it was
(the kernel's fbdev restore also resets it).

The plane turned is the CRTC's own primary plane, the one legacy
drmModeSetCrtc() and drmModePageFlip() use: the primary plane bound to
the CRTC, else the CRTC's index among the primary planes (MSM's DPU
lists every plane as possible on every CRTC and gives CRTC i the i-th
primary), else the first usable one. If that plane cannot rotate,
nothing is turned.

The cursor plane is not turned: the cursor's image is turned in
software when it is put in the cursor buffer, and its position mapped
from SDL's coordinates to the CRTC's, hot spot included.

SDL_KMSDRM_PANEL_ROTATION=0 leaves the panel alone; 90, 180 or 270
turn it by that many degrees (counter-clockwise, as DRM counts).

On displays without a "panel orientation", or one that says Normal,
nothing changes.
---
diff --git a/src/video/kmsdrm/SDL_kmsdrmmouse.c b/src/video/kmsdrm/SDL_kmsdrmmouse.c
index c589476..1d36bc9 100644
--- a/src/video/kmsdrm/SDL_kmsdrmmouse.c
+++ b/src/video/kmsdrm/SDL_kmsdrmmouse.c
@@ -60,6 +60,94 @@ static SDL_Cursor *KMSDRM_CreateDefaultCursor(void)
     return SDL_CreateCursor(default_cdata, default_cmask, DEFAULT_CWIDTH, DEFAULT_CHEIGHT, DEFAULT_CHOTX, DEFAULT_CHOTY);
 }
 
+/* Panel rotation (LightMoss). The cursor plane is not turned with the
+   primary plane (KMSDRM_SetupPanelRotation), so on a turned panel the
+   cursor's image is turned here, and its position is mapped from SDL's
+   (turned) coordinates to the CRTC's, with the hot spot on the pointer
+   (the kernel only honours drmModeSetCursor2's hot spot on virtual GPUs).
+   Nothing changes when the panel is not turned. */
+static uint64_t KMSDRM_CursorRotation(SDL_DisplayData *dispdata)
+{
+    return dispdata->rot_plane_id ? dispdata->rot_value : DRM_MODE_ROTATE_0;
+}
+
+/* Where the cursor BO's top-left corner goes on the CRTC for the pointer at
+   (x, y), in SDL's coordinates, on a turned panel. DRM turns a plane's image
+   counter-clockwise: with ROTATE_270, SDL's (x, y) is the CRTC's
+   (hdisplay - 1 - y, x); with ROTATE_90, (y, vdisplay - 1 - x). */
+static void KMSDRM_CursorCrtcPosition(SDL_DisplayData *dispdata, const KMSDRM_CursorData *curdata,
+                                      int x, int y, int *crtc_x, int *crtc_y)
+{
+    const int dw = dispdata->mode.hdisplay;
+    const int dh = dispdata->mode.vdisplay;
+
+    /* The image's top-left corner, in SDL's coordinates. */
+    x -= curdata->hot_x;
+    y -= curdata->hot_y;
+    switch (KMSDRM_CursorRotation(dispdata)) {
+    case DRM_MODE_ROTATE_90:
+        *crtc_x = y;
+        *crtc_y = dh - x - curdata->w;
+        break;
+    case DRM_MODE_ROTATE_180:
+        *crtc_x = dw - x - curdata->w;
+        *crtc_y = dh - y - curdata->h;
+        break;
+    case DRM_MODE_ROTATE_270:
+        *crtc_x = dw - y - curdata->h;
+        *crtc_y = x;
+        break;
+    default:
+        *crtc_x = x;
+        *crtc_y = y;
+        break;
+    }
+}
+
+/* Copies the cursor's image into buf (the BO's layout) turned the way the
+   panel is, so it shows upright: its top-left corner at the BO's. */
+static void KMSDRM_TurnCursorImage(const KMSDRM_CursorData *curdata, uint64_t rotation,
+                                   uint8_t *buf, size_t stride, uint64_t bo_w, uint64_t bo_h)
+{
+    int i, j;
+
+    for (j = 0; j < curdata->h; j++) {
+        for (i = 0; i < curdata->w; i++) {
+            const uint32_t pixel = curdata->buffer[j * curdata->w + i];
+            uint64_t dx, dy;
+
+            switch (rotation) {
+            case DRM_MODE_ROTATE_90:
+                dx = (uint64_t)j;
+                dy = (uint64_t)(curdata->w - 1 - i);
+                break;
+            case DRM_MODE_ROTATE_180:
+                dx = (uint64_t)(curdata->w - 1 - i);
+                dy = (uint64_t)(curdata->h - 1 - j);
+                break;
+            default: /* DRM_MODE_ROTATE_270 */
+                dx = (uint64_t)(curdata->h - 1 - j);
+                dy = (uint64_t)i;
+                break;
+            }
+            if (dx < bo_w && dy < bo_h) {
+                SDL_memcpy(buf + dy * stride + dx * 4, &pixel, 4);
+            }
+        }
+    }
+}
+
+/* drmModeMoveCursor() for the pointer at (x, y), in SDL's coordinates. */
+static int KMSDRM_MoveCursorTo(SDL_DisplayData *dispdata, SDL_Cursor *cursor, int x, int y)
+{
+    int crtc_x = x, crtc_y = y;
+
+    if (cursor && cursor->driverdata && KMSDRM_CursorRotation(dispdata) != DRM_MODE_ROTATE_0) {
+        KMSDRM_CursorCrtcPosition(dispdata, (KMSDRM_CursorData *)cursor->driverdata, x, y, &crtc_x, &crtc_y);
+    }
+    return KMSDRM_drmModeMoveCursor(dispdata->cursor_bo_drm_fd, dispdata->crtc->crtc_id, crtc_x, crtc_y);
+}
+
 /* Given a display's driverdata, destroy the cursor BO for it.
    To be called from KMSDRM_DestroyWindow(), as that's where we
    destroy the driverdata for the window's display. */
@@ -148,6 +236,7 @@ static int KMSDRM_DumpCursorToBO(SDL_VideoDisplay *display, SDL_Cursor *cursor)
     size_t bufsize;
     uint8_t *ready_buffer = NULL;
     uint8_t *src_row;
+    uint64_t rotation;
 
     int i;
     int ret;
@@ -169,9 +258,14 @@ static int KMSDRM_DumpCursorToBO(SDL_VideoDisplay *display, SDL_Cursor *cursor)
     }
 
     /* Copy from the cursor buffer to a buffer that we can dump to the GBM BO. */
-    for (i = 0; i < curdata->h; i++) {
-        src_row = &((uint8_t *)curdata->buffer)[i * curdata->w * 4];
-        SDL_memcpy(ready_buffer + (i * bo_stride), src_row, (size_t)4 * curdata->w);
+    rotation = KMSDRM_CursorRotation(dispdata);
+    if (rotation != DRM_MODE_ROTATE_0) {
+        KMSDRM_TurnCursorImage(curdata, rotation, ready_buffer, bo_stride, dispdata->cursor_w, dispdata->cursor_h);
+    } else {
+        for (i = 0; i < curdata->h; i++) {
+            src_row = &((uint8_t *)curdata->buffer)[i * curdata->w * 4];
+            SDL_memcpy(ready_buffer + (i * bo_stride), src_row, (size_t)4 * curdata->w);
+        }
     }
 
     /* Dump the cursor buffer to our GBM BO. */
@@ -182,7 +276,16 @@ static int KMSDRM_DumpCursorToBO(SDL_VideoDisplay *display, SDL_Cursor *cursor)
 
     /* Put the GBM BO buffer on screen using the DRM interface. */
     bo_handle = KMSDRM_gbm_bo_get_handle(dispdata->cursor_bo).u32;
-    if (curdata->hot_x == 0 && curdata->hot_y == 0) {
+    if (rotation != DRM_MODE_ROTATE_0) {
+        /* The hot spot is in the position: put the new image where it
+           belongs for the pointer's current position. */
+        ret = KMSDRM_drmModeSetCursor(viddata->drm_fd, dispdata->crtc->crtc_id,
+                                      bo_handle, dispdata->cursor_w, dispdata->cursor_h);
+        if (!ret) {
+            SDL_Mouse *mouse = SDL_GetMouse();
+            KMSDRM_MoveCursorTo(dispdata, cursor, mouse->x, mouse->y);
+        }
+    } else if (curdata->hot_x == 0 && curdata->hot_y == 0) {
         ret = KMSDRM_drmModeSetCursor(viddata->drm_fd, dispdata->crtc->crtc_id,
                                       bo_handle, dispdata->cursor_w, dispdata->cursor_h);
     } else {
@@ -378,7 +481,7 @@ static int KMSDRM_WarpMouseGlobal(int x, int y)
         if (dispdata->cursor_bo) {
             int ret = 0;
 
-            ret = KMSDRM_drmModeMoveCursor(dispdata->cursor_bo_drm_fd, dispdata->crtc->crtc_id, x, y);
+            ret = KMSDRM_MoveCursorTo(dispdata, mouse->cur_cursor, x, y);
 
             if (ret) {
                 SDL_SetError("drmModeMoveCursor() failed.");
@@ -438,7 +541,7 @@ static void KMSDRM_MoveCursor(SDL_Cursor *cursor)
             return;
         }
 
-        ret = KMSDRM_drmModeMoveCursor(dispdata->cursor_bo_drm_fd, dispdata->crtc->crtc_id, mouse->x, mouse->y);
+        ret = KMSDRM_MoveCursorTo(dispdata, mouse->cur_cursor, mouse->x, mouse->y);
 
         if (ret) {
             SDL_SetError("drmModeMoveCursor() failed.");
diff --git a/src/video/kmsdrm/SDL_kmsdrmvideo.c b/src/video/kmsdrm/SDL_kmsdrmvideo.c
index 8f080c2..0e7d413 100644
--- a/src/video/kmsdrm/SDL_kmsdrmvideo.c
+++ b/src/video/kmsdrm/SDL_kmsdrmvideo.c
@@ -713,6 +713,210 @@ static SDL_bool KMSDRM_CrtcGetVrr(uint32_t drm_fd, uint32_t crtc_id)
 
 /* Gets a DRM connector, builds an SDL_Display with it, and adds it to the
    list of SDL Displays in _this->displays[]  */
+/* Panel rotation (LightMoss).
+ *
+ * A panel mounted rotated reports it in its connector's "panel orientation"
+ * property (from the device tree's "rotation"). The kernel's own console
+ * turns its text to match; nothing turns what a KMS/DRM program shows. Where
+ * the CRTC's primary plane can rotate (a "rotation" property offering the
+ * angle), turn it, the same way the kernel's fbdev emulation would for 0 and
+ * 180 degrees: Left Side Up -> 90, Upside Down -> 180, Right Side Up -> 270.
+ * For 90 and 270 SDL then shows the display with its sides swapped, renders
+ * into buffers of that size, and the plane scans them out turned.
+ *
+ * SDL_KMSDRM_PANEL_ROTATION overrides it: "0" leaves the panel alone,
+ * "90", "180" or "270" turns the plane by that many degrees (counter-
+ * clockwise, as DRM counts) whatever the connector says.
+ */
+static uint64_t KMSDRM_PanelOrientationRotation(int drm_fd, uint32_t connector_id)
+{
+    drmModeObjectPropertiesPtr props;
+    uint64_t rotation = DRM_MODE_ROTATE_0;
+    uint32_t i;
+    int j;
+
+    props = KMSDRM_drmModeObjectGetProperties(drm_fd, connector_id, DRM_MODE_OBJECT_CONNECTOR);
+    if (!props) {
+        return rotation;
+    }
+    for (i = 0; i < props->count_props; i++) {
+        drmModePropertyPtr prop = KMSDRM_drmModeGetProperty(drm_fd, props->props[i]);
+        if (!prop) {
+            continue;
+        }
+        if (SDL_strcmp(prop->name, "panel orientation") == 0 && (prop->flags & DRM_MODE_PROP_ENUM)) {
+            for (j = 0; j < prop->count_enums; j++) {
+                if (prop->enums[j].value != props->prop_values[i]) {
+                    continue;
+                }
+                if (SDL_strcmp(prop->enums[j].name, "Upside Down") == 0) {
+                    rotation = DRM_MODE_ROTATE_180;
+                } else if (SDL_strcmp(prop->enums[j].name, "Left Side Up") == 0) {
+                    rotation = DRM_MODE_ROTATE_90;
+                } else if (SDL_strcmp(prop->enums[j].name, "Right Side Up") == 0) {
+                    rotation = DRM_MODE_ROTATE_270;
+                }
+            }
+        }
+        KMSDRM_drmModeFreeProperty(prop);
+    }
+    KMSDRM_drmModeFreeObjectProperties(props);
+    return rotation;
+}
+
+/* The CRTC's own primary plane: the one legacy drmModeSetCrtc() and
+   drmModePageFlip() scan out from (crtc->primary). Every plane may list
+   every CRTC as possible (MSM's DPU does), so the first compatible primary
+   plane is not necessarily it. In order: the primary plane bound to the CRTC
+   now, else the crtc_index-th primary plane (drivers create one primary per
+   CRTC, in CRTC order), else the first primary plane that can be used with
+   it. *rot_prop is that plane's "rotation" property if it offers rot_bit,
+   else 0. Returns 0 when there is no primary plane at all. */
+static uint32_t KMSDRM_CrtcPrimaryPlane(int drm_fd, uint32_t crtc_id, int crtc_index,
+                                        int rot_bit, uint32_t *rot_prop)
+{
+    drmModePlaneResPtr planes;
+    uint32_t found[3] = { 0, 0, 0 };  /* bound, by index, first compatible */
+    uint32_t found_rot[3] = { 0, 0, 0 };
+    int primary_index = 0;
+    uint32_t i, k;
+    int j;
+
+    *rot_prop = 0;
+    planes = KMSDRM_drmModeGetPlaneResources(drm_fd);
+    if (!planes) {
+        return 0;
+    }
+    for (i = 0; i < planes->count_planes && !found[0]; i++) {
+        drmModePlanePtr plane = KMSDRM_drmModeGetPlane(drm_fd, planes->planes[i]);
+        drmModeObjectPropertiesPtr props;
+        SDL_bool primary = SDL_FALSE;
+        uint32_t rot = 0;
+
+        if (!plane) {
+            continue;
+        }
+        props = KMSDRM_drmModeObjectGetProperties(drm_fd, plane->plane_id, DRM_MODE_OBJECT_PLANE);
+        for (k = 0; props && k < props->count_props; k++) {
+            drmModePropertyPtr prop = KMSDRM_drmModeGetProperty(drm_fd, props->props[k]);
+            if (!prop) {
+                continue;
+            }
+            if (SDL_strcmp(prop->name, "type") == 0) {
+                primary = (props->prop_values[k] == DRM_PLANE_TYPE_PRIMARY) ? SDL_TRUE : SDL_FALSE;
+            } else if (SDL_strcmp(prop->name, "rotation") == 0 && (prop->flags & DRM_MODE_PROP_BITMASK)) {
+                for (j = 0; j < prop->count_enums; j++) {
+                    if (prop->enums[j].value == (uint64_t)rot_bit) {
+                        rot = prop->prop_id;
+                    }
+                }
+            }
+            KMSDRM_drmModeFreeProperty(prop);
+        }
+        if (props) {
+            KMSDRM_drmModeFreeObjectProperties(props);
+        }
+        if (primary) {
+            const SDL_bool compatible = (plane->possible_crtcs & (1u << crtc_index)) ? SDL_TRUE : SDL_FALSE;
+            if (plane->crtc_id == crtc_id) {
+                found[0] = plane->plane_id;
+                found_rot[0] = rot;
+            }
+            if (primary_index == crtc_index && compatible && !found[1]) {
+                found[1] = plane->plane_id;
+                found_rot[1] = rot;
+            }
+            if (compatible && !found[2]) {
+                found[2] = plane->plane_id;
+                found_rot[2] = rot;
+            }
+            primary_index++;
+        }
+        KMSDRM_drmModeFreePlane(plane);
+    }
+    KMSDRM_drmModeFreePlaneResources(planes);
+
+    for (j = 0; j < 3; j++) {
+        if (found[j]) {
+            *rot_prop = found_rot[j];
+            return found[j];
+        }
+    }
+    return 0;
+}
+
+static void KMSDRM_SetupPanelRotation(_THIS, SDL_DisplayData *dispdata, drmModeRes *resources)
+{
+    SDL_VideoData *viddata = (SDL_VideoData *)_this->driverdata;
+    int drm_fd = viddata->drm_fd;
+    const char *hint = SDL_getenv("SDL_KMSDRM_PANEL_ROTATION");
+    uint64_t rotation;
+    uint32_t plane_id, rot_prop;
+    int crtc_index = -1;
+    int rot_bit;
+    int j;
+
+    if (hint && *hint) {
+        switch (SDL_atoi(hint)) {
+        case 90:  rotation = DRM_MODE_ROTATE_90;  break;
+        case 180: rotation = DRM_MODE_ROTATE_180; break;
+        case 270: rotation = DRM_MODE_ROTATE_270; break;
+        default:  rotation = DRM_MODE_ROTATE_0;   break;
+        }
+    } else {
+        rotation = KMSDRM_PanelOrientationRotation(drm_fd, dispdata->connector->connector_id);
+    }
+    if (rotation == DRM_MODE_ROTATE_0) {
+        return;
+    }
+    for (j = 0; j < resources->count_crtcs; j++) {
+        if (resources->crtcs[j] == dispdata->crtc->crtc_id) {
+            crtc_index = j;
+            break;
+        }
+    }
+    if (crtc_index < 0) {
+        return;
+    }
+    /* The bit of the rotation in the property's bitmask. */
+    for (rot_bit = 0; rot_bit < 4 && !(rotation & (1ULL << rot_bit)); rot_bit++) {
+    }
+
+    KMSDRM_drmSetClientCap(drm_fd, DRM_CLIENT_CAP_UNIVERSAL_PLANES, 1);
+    plane_id = KMSDRM_CrtcPrimaryPlane(drm_fd, dispdata->crtc->crtc_id, crtc_index, rot_bit, &rot_prop);
+    if (plane_id && rot_prop) {
+        dispdata->rot_plane_id = plane_id;
+        dispdata->rot_prop_id = rot_prop;
+        dispdata->rot_value = rotation;
+        dispdata->rot_swap = (rotation == DRM_MODE_ROTATE_90 || rotation == DRM_MODE_ROTATE_270) ? SDL_TRUE : SDL_FALSE;
+        SDL_LogDebug(SDL_LOG_CATEGORY_VIDEO, "KMSDRM: panel turned by plane %u, rotation 0x%x",
+                     (unsigned)dispdata->rot_plane_id, (unsigned)dispdata->rot_value);
+    } else {
+        SDL_LogWarn(SDL_LOG_CATEGORY_VIDEO, "KMSDRM: the panel is mounted rotated, but the CRTC's primary plane (%u) cannot turn it",
+                    (unsigned)plane_id);
+    }
+}
+
+/* Turns the plane (on), or puts it back upright (off) before the original
+   CRTC configuration, the console's, is restored. Needs DRM master. A plane
+   that refuses leaves the display unturned, sides unswapped. */
+static void KMSDRM_ApplyPanelRotation(_THIS, SDL_DisplayData *dispdata, SDL_bool on)
+{
+    SDL_VideoData *viddata = (SDL_VideoData *)_this->driverdata;
+
+    if (!dispdata->rot_plane_id) {
+        return;
+    }
+    if (KMSDRM_drmModeObjectSetProperty(viddata->drm_fd, dispdata->rot_plane_id, DRM_MODE_OBJECT_PLANE,
+                                        dispdata->rot_prop_id, on ? dispdata->rot_value : DRM_MODE_ROTATE_0) != 0) {
+        if (on) {
+            SDL_LogWarn(SDL_LOG_CATEGORY_VIDEO, "KMSDRM: could not turn the panel's plane, showing it unturned");
+            dispdata->rot_plane_id = 0;
+            dispdata->rot_swap = SDL_FALSE;
+        }
+    }
+}
+
 static void KMSDRM_AddDisplay(_THIS, drmModeConnector *connector, drmModeRes *resources)
 {
     SDL_VideoData *viddata = ((SDL_VideoData *)_this->driverdata);
@@ -874,6 +1078,9 @@ static void KMSDRM_AddDisplay(_THIS, drmModeConnector *connector, drmModeRes *re
     dispdata->connector = connector;
     dispdata->crtc = crtc;
 
+    /* A panel mounted rotated: which plane turns it, and by how much. */
+    KMSDRM_SetupPanelRotation(_this, dispdata, resources);
+
     /* save previous vrr state */
     dispdata->saved_vrr = KMSDRM_CrtcGetVrr(viddata->drm_fd, crtc->crtc_id);
     /* try to enable vrr */
@@ -898,8 +1105,8 @@ static void KMSDRM_AddDisplay(_THIS, drmModeConnector *connector, drmModeRes *re
     modedata->mode_index = mode_index;
 
     display.driverdata = dispdata;
-    display.desktop_mode.w = dispdata->mode.hdisplay;
-    display.desktop_mode.h = dispdata->mode.vdisplay;
+    display.desktop_mode.w = KMSDRM_MODE_W(dispdata, dispdata->mode);
+    display.desktop_mode.h = KMSDRM_MODE_H(dispdata, dispdata->mode);
     display.desktop_mode.refresh_rate = dispdata->mode.vrefresh;
     display.desktop_mode.format = SDL_PIXELFORMAT_ARGB8888;
     display.desktop_mode.driverdata = modedata;
@@ -1097,6 +1304,9 @@ static void KMSDRM_DestroySurfaces(_THIS, SDL_Window *window)
     /* original video mode and make it point to the original TTY buffer.   */
     /***********************************************************************/
 
+    /* The console's buffer is upright: the panel's plane goes back first. */
+    KMSDRM_ApplyPanelRotation(_this, dispdata, SDL_FALSE);
+
     ret = KMSDRM_drmModeSetCrtc(viddata->drm_fd, dispdata->crtc->crtc_id,
                                 dispdata->crtc->buffer_id, 0, 0, &dispdata->connector->connector_id, 1,
                                 &dispdata->original_mode);
@@ -1181,7 +1391,9 @@ static void KMSDRM_DirtySurfaces(SDL_Window *window)
        or SetWindowFullscreen, send a fake event for now since the actual
        recreation is deferred */
     KMSDRM_GetModeToSet(window, &mode);
-    SDL_SendWindowEvent(window, SDL_WINDOWEVENT_RESIZED, mode.hdisplay, mode.vdisplay);
+    SDL_SendWindowEvent(window, SDL_WINDOWEVENT_RESIZED,
+                        KMSDRM_MODE_W((SDL_DisplayData *)SDL_GetDisplayForWindow(window)->driverdata, mode),
+                        KMSDRM_MODE_H((SDL_DisplayData *)SDL_GetDisplayForWindow(window)->driverdata, mode));
 }
 
 /* This determines the size of the fb, which comes from the GBM surface
@@ -1216,13 +1428,18 @@ int KMSDRM_CreateSurfaces(_THIS, SDL_Window *window)
        mode that's set in sync with what SDL_video.c thinks is set */
     KMSDRM_GetModeToSet(window, &dispdata->mode);
 
-    display->current_mode.w = dispdata->mode.hdisplay;
-    display->current_mode.h = dispdata->mode.vdisplay;
+    /* Turn the panel's plane now, while this program is DRM master, so the
+       first drmModeSetCrtc() in SwapWindow() scans out the turned buffer. */
+    KMSDRM_ApplyPanelRotation(_this, dispdata, SDL_TRUE);
+
+    display->current_mode.w = KMSDRM_MODE_W(dispdata, dispdata->mode);
+    display->current_mode.h = KMSDRM_MODE_H(dispdata, dispdata->mode);
     display->current_mode.refresh_rate = dispdata->mode.vrefresh;
     display->current_mode.format = SDL_PIXELFORMAT_ARGB8888;
 
     windata->gs = KMSDRM_gbm_surface_create(viddata->gbm_dev,
-                                            dispdata->mode.hdisplay, dispdata->mode.vdisplay,
+                                            KMSDRM_MODE_W(dispdata, dispdata->mode),
+                                            KMSDRM_MODE_H(dispdata, dispdata->mode),
                                             surface_fmt, surface_flags);
 
     if (!windata->gs) {
@@ -1246,7 +1463,8 @@ int KMSDRM_CreateSurfaces(_THIS, SDL_Window *window)
     ret = SDL_EGL_MakeCurrent(_this, windata->egl_surface, egl_context);
 
     SDL_SendWindowEvent(window, SDL_WINDOWEVENT_RESIZED,
-                        dispdata->mode.hdisplay, dispdata->mode.vdisplay);
+                        KMSDRM_MODE_W(dispdata, dispdata->mode),
+                        KMSDRM_MODE_H(dispdata, dispdata->mode));
 
     windata->egl_surface_dirty = SDL_FALSE;
 
@@ -1363,8 +1581,8 @@ void KMSDRM_GetDisplayModes(_THIS, SDL_VideoDisplay *display)
             modedata->mode_index = i;
         }
 
-        mode.w = conn->modes[i].hdisplay;
-        mode.h = conn->modes[i].vdisplay;
+        mode.w = KMSDRM_MODE_W(dispdata, conn->modes[i]);
+        mode.h = KMSDRM_MODE_H(dispdata, conn->modes[i]);
         mode.refresh_rate = conn->modes[i].vrefresh;
         mode.format = SDL_PIXELFORMAT_ARGB8888;
         mode.driverdata = modedata;
diff --git a/src/video/kmsdrm/SDL_kmsdrmvideo.h b/src/video/kmsdrm/SDL_kmsdrmvideo.h
index 1643143..8b7cb85 100644
--- a/src/video/kmsdrm/SDL_kmsdrmvideo.h
+++ b/src/video/kmsdrm/SDL_kmsdrmvideo.h
@@ -119,8 +119,32 @@ typedef struct SDL_DisplayData
     uint64_t cursor_w, cursor_h;
 
     SDL_bool default_cursor_init;
