# LightMoss: changes on top of ROCKNIX's SM8250 kernel configuration
# (rocknix-sm8250.config, projects/ROCKNIX/devices/SM8250/linux/linux.aarch64.conf
# in github.com/ROCKNIX/distribution, unchanged). ROCKNIX fills in these
# placeholders at build time; LightMoss boots without an initramfs of its own
# (the boot files' initramfs only carries firmware, see post-image.sh).
CONFIG_LOCALVERSION="-lightmoss"
CONFIG_DEFAULT_HOSTNAME="lightmoss"
CONFIG_INITRAMFS_SOURCE=""
# The PMIC RTC keeps its offset in PM8150 SDAM (3-sm8250/0102): with the SDAM
# driver built in, the RTC and hctosys come up before PID 1, whose clock checks
# and lightmoss-clock.service then see the RTC's time, not a later jump.
CONFIG_NVMEM_SPMI_SDAM=y
# Until spruce sets its own governors (and through installs and first boots).
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
# Suspend diagnostics: /sys/power/pm_print_times, pm_debug_messages, pm_wakeup_irq.
CONFIG_PM_DEBUG=y
