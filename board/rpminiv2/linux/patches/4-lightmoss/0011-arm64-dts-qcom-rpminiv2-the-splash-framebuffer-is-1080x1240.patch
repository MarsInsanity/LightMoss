From 6efe582ae874e468d57e860501a8ec1f4dd2d696 Mon Sep 17 00:00:00 2001
From: LightMoss <noreply@github.com>
Date: Wed, 18 Nov 2026 14:58:42 +0000
Subject: [PATCH] arm64: dts: qcom: rpminiv2: the splash framebuffer is
 1080x1240

The Mini V2 tree includes the Mini's and inherited its simple-framebuffer
node, 960x1280 with a 3840-byte stride, while the Mini V2's panel is
1080x1240. Nothing reads the node today (no simplefb or simpledrm in the
kernel, efifb off on the command line), but an early console or splash
driver would read the bootloader's framebuffer with the wrong geometry.
The reserved region (35 MiB) covers either size.
---
 arch/arm64/boot/dts/qcom/sm8250-retroidpocket-rpminiv2.dts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-retroidpocket-rpminiv2.dts b/arch/arm64/boot/dts/qcom/sm8250-retroidpocket-rpminiv2.dts
index e5f4ac022..5e4319db5 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-retroidpocket-rpminiv2.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-retroidpocket-rpminiv2.dts
@@ -12,6 +12,13 @@ / {
 	compatible = "retroidpocket,rpminiv2", "qcom,sm8250";
 };
 
+/* The bootloader's splash on the 1080x1240 panel, not the Mini's 960x1280. */
+&framebuffer {
+	width = <1080>;
+	height = <1240>;
+	stride = <(1080 * 4)>;
+};
+
 &i2c13 {
 	touchscreen@38 {
 		touchscreen-size-x = <1080>;
