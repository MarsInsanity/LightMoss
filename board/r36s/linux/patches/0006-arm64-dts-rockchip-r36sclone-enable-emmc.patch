From: LightMoss <lightmoss@localhost>
Subject: [PATCH] arm64: dts: rockchip: r36sclone: enable the internal eMMC

LightMoss installs to the G80CA's internal eMMC (4 GB on the units that
ship with EmuELEC on it), so Linux needs to see it. Root is mounted by
PARTUUID, so the extra mmcblk device does not reorder the boot card.
---
diff --git a/arch/arm64/boot/dts/rockchip/rk3326-r36sclone-linux.dts b/arch/arm64/boot/dts/rockchip/rk3326-r36sclone-linux.dts
index 0934c3c3e..da53a665f 100644
--- a/arch/arm64/boot/dts/rockchip/rk3326-r36sclone-linux.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3326-r36sclone-linux.dts
@@ -453,6 +453,25 @@
 	status = "okay";
 };
 
+/*
+ * LightMoss: the internal eMMC (4 GB on the units that ship with EmuELEC on
+ * it). Enabled so the base OS can be installed to it from a TF1 boot. Plain
+ * high-speed (52 MHz) mode: the bus width is negotiated down from 8 if fewer
+ * data lines are wired. Root is mounted by PARTUUID, so the extra mmcblk
+ * device cannot reorder the boot card.
+ */
+&emmc {
+	bus-width = <8>;
+	cap-mmc-highspeed;
+	supports-emmc;
+	disable-wp;
+	non-removable;
+	num-slots = <1>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&emmc_clk &emmc_cmd &emmc_bus8>;
+	status = "okay";
+};
+
 &gpu {
 	mali-supply = <&vdd_logic>;
 	status = "okay";
