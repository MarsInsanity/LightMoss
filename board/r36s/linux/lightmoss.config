# LightMoss: changes on top of christianhaitian's rg351p_tweaked_defconfig.
# Only what the R36S clone (G80CA) has, and what systemd, NetworkManager and
# spruce need, is kept.

CONFIG_LOCALVERSION="-lightmoss"
# CONFIG_LOCALVERSION_AUTO is not set

# --- systemd 257 on a 4.4 kernel (cgroup v1, see boot.ini) ------------------
CONFIG_CGROUPS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS4_FS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_UEVENT_HELPER_PATH=""
# CONFIG_FW_LOADER_USER_HELPER is not set
# CONFIG_DMIID is not set

# --- filesystems -------------------------------------------------------------
# spruce's card is FAT32 or exFAT; built in so the mount never waits on modprobe.
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_EXT4_FS=y
# Nothing on the device uses btrfs (the rootfs is ext4).
# CONFIG_BTRFS_FS is not set
# PortMaster ships its runtimes (Mono, LOVE, ...) as squashfs images it
# loop-mounts, some with an overlay on top.
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_OVERLAY_FS=y

# --- Wi-Fi: only the MT7601U USB dongle on the OTG port ------------------------
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_MT7601U=m
# CONFIG_WL_ROCKCHIP is not set
# CONFIG_RTL_WIRELESS_SOLUTION is not set
# CONFIG_RTL8188EU is not set
# CONFIG_RTL8188FU is not set
# CONFIG_RTL8812AU is not set
# CONFIG_RTL8822BU is not set
# CONFIG_RTL8821CU is not set
# CONFIG_RTL8723BU is not set
# CONFIG_ESP8089 is not set
# CONFIG_RTL8187 is not set
# CONFIG_RTL_CARDS is not set
# CONFIG_ATH_CARDS is not set
# CONFIG_AR5523 is not set
# CONFIG_ATH10K is not set
# CONFIG_WCN36XX is not set
# CONFIG_B43 is not set
# CONFIG_B43LEGACY is not set
# CONFIG_BRCMSMAC is not set
# CONFIG_BRCMFMAC is not set
# CONFIG_HOSTAP is not set
# CONFIG_LIBERTAS is not set
# CONFIG_LIBERTAS_THINFIRM is not set
# CONFIG_AT76C50X_USB is not set
# CONFIG_USB_ZD1201 is not set
# CONFIG_USB_NET_RNDIS_WLAN is not set
# CONFIG_P54_COMMON is not set
# CONFIG_RT2X00 is not set
# CONFIG_WL_TI is not set
# CONFIG_ZD1211RW is not set
# CONFIG_MWIFIEX is not set
# CONFIG_CW1200 is not set
# CONFIG_RSI_91X is not set
# CONFIG_R8712U is not set
# CONFIG_R8723AU is not set
# CONFIG_SSB is not set
# CONFIG_BCMA is not set

# --- radios and network features the device does not have or use -------------
# CONFIG_BT is not set
# CONFIG_NFC is not set
# CONFIG_IEEE802154 is not set
# CONFIG_6LOWPAN is not set
# CONFIG_ATM is not set
# CONFIG_L2TP is not set
# CONFIG_IPX is not set
# CONFIG_ATALK is not set
# CONFIG_PHONET is not set
# CONFIG_RDS is not set
# CONFIG_BATMAN_ADV is not set
# CONFIG_OPENVSWITCH is not set
# CONFIG_NET_DSA is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_NETFILTER is not set
# CONFIG_NET_SCHED is not set
# CONFIG_NET_KEY is not set
# CONFIG_NET_IPIP is not set
# CONFIG_NET_IPGRE_DEMUX is not set
# CONFIG_NET_IPVTI is not set
# CONFIG_NET_FOU is not set
# CONFIG_INET_AH is not set
# CONFIG_INET_ESP is not set
# CONFIG_INET_IPCOMP is not set
# CONFIG_VSOCKETS is not set
# CONFIG_VHOST_NET is not set
# CONFIG_PPP is not set
# CONFIG_SLIP is not set
# CONFIG_NETCONSOLE is not set
# CONFIG_VETH is not set
# CONFIG_NLMON is not set
# CONFIG_USB_NET_DRIVERS is not set
# CONFIG_USB_SERIAL is not set
CONFIG_IPV6=y

# --- USB gadget: no adbd, the OTG port stays a host for the dongle ------------
# CONFIG_USB_CONFIGFS is not set
# CONFIG_USB_ETH is not set
# CONFIG_USB_G_NCM is not set

# --- legacy joysticks (gameport and serial) -----------------------------------
# CONFIG_GAMEPORT is not set
# CONFIG_JOYSTICK_ANALOG is not set
# CONFIG_JOYSTICK_A3D is not set
# CONFIG_JOYSTICK_ADI is not set
# CONFIG_JOYSTICK_COBRA is not set
# CONFIG_JOYSTICK_GF2K is not set
# CONFIG_JOYSTICK_GRIP is not set
# CONFIG_JOYSTICK_GRIP_MP is not set
# CONFIG_JOYSTICK_GUILLEMOT is not set
# CONFIG_JOYSTICK_INTERACT is not set
# CONFIG_JOYSTICK_SIDEWINDER is not set
# CONFIG_JOYSTICK_TMDC is not set
# CONFIG_JOYSTICK_IFORCE is not set
# CONFIG_JOYSTICK_WARRIOR is not set
# CONFIG_JOYSTICK_MAGELLAN is not set
# CONFIG_JOYSTICK_SPACEORB is not set
# CONFIG_JOYSTICK_SPACEBALL is not set
# CONFIG_JOYSTICK_STINGER is not set
# CONFIG_JOYSTICK_TWIDJOY is not set
# CONFIG_JOYSTICK_ZHENHUA is not set
# CONFIG_JOYSTICK_AS5011 is not set
# CONFIG_JOYSTICK_JOYDUMP is not set
# CONFIG_SERIO_SERPORT is not set
# Kept: xpad and HID for external USB pads, USB audio for DACs (spruce
# supports both), and the R36S's own odroidgo3-joypad.
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_ODROIDGO3=y
CONFIG_SND_USB_AUDIO=y

