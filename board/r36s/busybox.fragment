# Applets spruce, PortMaster's port scripts and LightMoss's own scripts call
# that buildroot's default busybox leaves out.
CONFIG_STAT=y
CONFIG_FEATURE_STAT_FORMAT=y
# awk with math (^, sqrt, ...): spruce's dArkMoss code finds the volume keys
# with 2^bit in awk; without it no node qualifies and the keys are ignored.
CONFIG_FEATURE_AWK_LIBM=y
CONFIG_FEATURE_STAT_FILESYSTEM=y
CONFIG_TIMEOUT=y
CONFIG_TAC=y
CONFIG_TASKSET=y
CONFIG_FEATURE_TASKSET_FANCY=y
CONFIG_FEATURE_TASKSET_CPULIST=y
CONFIG_IONICE=y
CONFIG_RFKILL=y
CONFIG_PGREP=y
CONFIG_PKILL=y
CONFIG_FINDFS=y
# dArkMossCommon.sh: echo MENU_TOGGLE | /usr/bin/nc -u -w1 127.0.0.1 55355
CONFIG_NC=y
CONFIG_NC_SERVER=y
CONFIG_NC_EXTRA=y
CONFIG_NC_110_COMPAT=y
CONFIG_FEATURE_PS_WIDE=y
CONFIG_FEATURE_PS_LONG=y
CONFIG_FEATURE_SHOW_THREADS=y
CONFIG_FEATURE_PS_ADDITIONAL_COLUMNS=y
