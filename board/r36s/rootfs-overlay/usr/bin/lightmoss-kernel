#!/bin/sh
# lightmoss-kernel [4.4|5.10]
#
# Shows, or chooses, the kernel the R36S starts next. 4.4 is LightMoss's
# default; 5.10 is the optional BSP 5.10 kernel with the Mali g29p1 blob
# (Vulkan). The choice is the file lightmoss-kernel-5.10 on the BOOT
# partition, which boot.ini reads (the LightMoss Kernel app in spruce sets
# it too); updates keep it. Every 5.10 start is a try: boot.ini leaves
# lightmoss-kernel-5.10-trying on BOOT until spruce is up on 5.10, and while
# that marker is there it starts 4.4. Choosing 5.10 here clears it, for
# another try.
set -u

usage() {
	echo "usage: lightmoss-kernel [4.4|5.10]  (no argument: show the current choice)" >&2
	exit 2
}

/usr/libexec/lightmoss/mount-boot || { echo "lightmoss-kernel: cannot mount BOOT" >&2; exit 1; }
flag=/boot/lightmoss-kernel-5.10
try=/boot/lightmoss-kernel-5.10-trying

next() {
	if [ -e "$flag" ] && [ -e /boot/Image-5.10 ] && [ ! -e "$try" ]; then echo 5.10; else echo 4.4; fi
}

case "${1:-}" in
"")
	echo "running:    $(uname -r)"
	echo "next start: $(next)"
	case "$(uname -r)" in
	5.10.*) ;;
	*) [ -e "$flag" ] && [ -e "$try" ] &&
		echo "(5.10 is chosen, but its last start did not keep spruce up for 3 minutes: run 'lightmoss-kernel 5.10' to try again)" ;;
	esac
	;;
5.10)
	[ -e /boot/Image-5.10 ] || { echo "lightmoss-kernel: this image has no Image-5.10" >&2; exit 1; }
	case "$(uname -r)" in 5.10.*) ;; *) rm -f "$try" ;; esac
	: > "$flag" && sync
	echo "next start: $(next) (restart to switch)"
	;;
4.4)
	rm -f "$flag" "$try" && sync
	echo "next start: $(next) (restart to switch)"
	;;
*) usage ;;
esac
