#!/bin/sh
# LightMoss updater (initramfs), on every start: boot.ini always loads it.
#
# With the charger connected, it looks at the root of every FAT32/exFAT
# partition of every card for a file whose name ends in .rkimg: a LightMoss
# release image (.img.xz), renamed. Only compressed images are taken: xz's
# checksum over the whole file is tested before anything is written. The
# first usable one is installed. Without the charger, or with no such file,
# the system starts at once.
#
# Where it goes, which nothing has mounted yet: the internal eMMC; or, when
# the LightMoss Update app has left lightmoss-update on the system's BOOT, the
# disk the system runs from (the eMMC or the card in TF1), in place. Never
# from a partition about to be overwritten.
#  - a disk that already holds LightMoss is updated: the loader, BOOT and the
#    system partition are rewritten; the partition table, SPRUCEOS (spruce on
#    it), the disk signature, the machine ID, the SSH host keys, the panel
#    choice (uboot.dtb), headphones-invert and lightmoss-debug stay;
#  - anything else on the eMMC (EmuELEC) is replaced by a fresh install.
# The charger is required because a write cut short leaves no system there (a
# LightMoss card in TF1 still boots, and can repair it).
#
# What was written is read back from the disk and compared with the image
# (one more try if it differs; then it stops and says so rather than start a
# damaged system). Afterwards the file is renamed <name>.rkimg.done and the
# device restarts.
# An image it cannot use is renamed <name>.rkimg.bad and the system starts as
# usual. When it found something to do, what it did goes to
# lightmoss-update.log on the BOOT partition it was started from.

# LM_UPDATER_TEST=1: only define the functions (board/r36s/test-updater.sh
# sources this file and runs update() against disk images).
if [ -z "$LM_UPDATER_TEST" ]; then
	export PATH=/bin
	/bin/busybox --install -s /bin 2>/dev/null
	mkdir -p /dev /proc /sys /tmp /mnt /newroot
	mount -t devtmpfs devtmpfs /dev
	mount -t proc proc /proc
	mount -t sysfs sysfs /sys
	exec </dev/console >/dev/console 2>&1
fi

TTY=/dev/tty1

LOG=/tmp/update.log

# On the screen and in the log.
say() {
	echo "lightmoss-update: $*"
	echo "$*" >> "$LOG"
	printf '\033[2J\033[H\n\n  LightMoss update\n\n  %s\n' "$*" > "$TTY" 2>/dev/null
}

# In the log only.
log() { echo "$*" >> "$LOG"; }

cmdline() { sed -n "s/.*\\b$1=\\([^ ]*\\).*/\\1/p" /proc/cmdline; }

part() { case "$1" in *[0-9]) echo "/dev/${1}p$2" ;; *) echo "/dev/$1$2" ;; esac; }

# MBR disk signature of a whole disk, as PARTUUID writes it (8 hex digits).
disksig() { od -An -tx4 -j 440 -N 4 "$1" 2>/dev/null | tr -d ' \n'; }

disks() {
	for d in /sys/block/mmcblk*; do
		n="${d##*/}"
		case "$n" in *boot*|*rpmb*) continue ;; esac
		[ -e "$d" ] && echo "$n"
	done
}

disktype() { cat "/sys/block/$1/device/type" 2>/dev/null; }

# A whole disk's device node, its partitions' nodes, and a partition's start
# and size in sectors (disk, partition node). The test harness replaces these.
dev() { echo "/dev/$1"; }
parts() { for p in /dev/"$1"p*; do [ -b "$p" ] && echo "$p"; done; }
pstart() { cat "/sys/block/$1/${2#/dev/}/start"; }
psize() { cat "/sys/block/$1/${2#/dev/}/size"; }

# A charger (or any power source) connected.
charger_online() {
	for f in /sys/class/power_supply/*/online; do
		[ "$(cat "$f" 2>/dev/null)" = 1 ] && return 0
	done
	return 1
}

# busybox blkid: /dev/x: LABEL="BOOT" UUID="..."
label() { blkid "$1" 2>/dev/null | sed -n 's/.*LABEL="\([^"]*\)".*/\1/p'; }

# Left on the system's BOOT by the LightMoss Update app: install on the disk
# the system runs from, not on the eMMC. (lightmoss-install, which earlier
# LightMoss needed next to an image, is only cleared away now.)
SELF_TRIGGER=lightmoss-update
OLD_TRIGGER=lightmoss-install

# A LightMoss image as released: xz-compressed (whose checksum xz -t tests).
is_image() {
	[ "$(od -An -tx1 -N 6 "$1" | tr -d ' \n')" = fd377a585a00 ]
}

# The SHA-256 of the first $2 bytes of disk $1, read from the disk itself
# rather than from what the page cache still holds of the write.
readback() {
	sync
	blockdev --flushbufs "$1" 2>/dev/null
	echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
	head -c "$2" "$1" | sha256sum | cut -c1-64
}

# Decompress $IMG onto the target, taking the image's SHA-256 and size on the
# way (tee into sha256sum and wc). Sets WANT and BYTES.
write_image() {
	rm -f /tmp/img.sum.fifo /tmp/img.len.fifo
	mkfifo /tmp/img.sum.fifo /tmp/img.len.fifo
	sha256sum < /tmp/img.sum.fifo > /tmp/img.sum &
	sumpid=$!
	wc -c < /tmp/img.len.fifo > /tmp/img.len &
	lenpid=$!
	# (notrunc: a no-op on a disk, but the test harness writes into a file.)
	xz -dc "$IMG" | tee /tmp/img.sum.fifo /tmp/img.len.fifo |
		dd of="$(dev "$TARGET")" bs=1M conv=notrunc,fsync 2>/tmp/dd.log
	rc=$?
	wait "$sumpid" "$lenpid"
	WANT="$(cut -c1-64 /tmp/img.sum)"
	BYTES="$(tr -d ' \n' < /tmp/img.len)"
	log "written: $(tr '\n' ' ' < /tmp/dd.log)($BYTES bytes, sha256 $WANT)"
	[ "$rc" = 0 ] || return 1
	# All of it: at least up to the end of the image's system partition.
	[ -n "$BYTES" ] && [ "$BYTES" -ge "$IMGEND" ] ||
		{ echo "the image ended after ${BYTES:-0} of $IMGEND bytes" > /tmp/dd.log; return 1; }
}

# Remove the flags from partition 1 of every disk, so they fire once.
clear_trigger() {
	mkdir -p /mnt/flag
	for d in $(disks); do
		p="$(part "$d" 1)"
		parts "$d" | grep -qx "$p" || continue
		mount -t vfat -o rw "$p" /mnt/flag 2>/dev/null || continue
		rm -f "/mnt/flag/$SELF_TRIGGER" "/mnt/flag/$OLD_TRIGGER"
		umount /mnt/flag
	done
}

# An update that cannot go ahead with this image at all: say why, set the
# image aside (<name>.rkimg.bad) and clear the flags, so the next start is a
# plain one rather than the same error again.
give_up() {
	say "$1 Starting without it..."
	[ -n "$IMG" ] && mv "$IMG" "$IMG.bad" 2>/dev/null
	umount /mnt/src 2>/dev/null
	clear_trigger
	sleep 12
	return 1
}

# ---------------------------------------------------------------- root disk --
if [ -z "$LM_UPDATER_TEST" ]; then
	ROOTSPEC="$(cmdline root)"
	SIG="${ROOTSPEC#PARTUUID=}"; SIG="${SIG%-*}"
	ROOTDISK=""
	n=0
	while [ -z "$ROOTDISK" ] && [ "$n" -lt 150 ]; do
		for d in $(disks); do
			[ "$(disksig "$(dev "$d")")" = "$SIG" ] && ROOTDISK="$d" && break
		done
		[ -n "$ROOTDISK" ] || { sleep 0.2; n=$((n + 1)); }
	done
fi

# The log, to BOOT on the disk the system was started from (the LightMoss card
# in TF1, as a rule), as lightmoss-update.log.
savelog() {
	[ -n "$ROOTDISK" ] || return 0
	mkdir -p /mnt/log
	mount -t vfat -o rw "$(part "$ROOTDISK" 1)" /mnt/log 2>/dev/null || return 0
	cp "$LOG" /mnt/log/lightmoss-update.log
	sync
	umount /mnt/log
}

# Something went wrong past the point of starting the system: say so and stay.
fail() {
	say "$*"
	savelog
	while :; do sleep 60; done
}

boot_system() {
	if [ -z "$ROOTDISK" ]; then
		say "No LightMoss system found (root=$ROOTSPEC). Power off and check the cards."
		while :; do sleep 60; done
	fi
	# rw, as the kernel mounts it without this initramfs (root=... rw): the
	# boot that follows is the same.
	mount -t ext4 -o rw "$(part "$ROOTDISK" 2)" /newroot || {
		say "Cannot mount $(part "$ROOTDISK" 2)."
		while :; do sleep 60; done
	}
	umount /proc /sys 2>/dev/null
	mount --move /dev /newroot/dev
	exec switch_root /newroot /sbin/init
}

# -------------------------------------------------------------- the update --
# The cards, once the list has stopped changing (a card can still be coming up
# when this starts), up to 3 s.
settle_disks() {
	prev=""; same=0; n=0
	while [ "$n" -lt 15 ]; do
		cur="$(disks | tr '\n' ' ')"
		if [ "$cur" = "$prev" ]; then
			same=$((same + 1))
			[ "$same" -ge 2 ] && return 0
		else
			same=0; prev="$cur"
		fi
		sleep 0.2; n=$((n + 1))
	done
}

update() {
	mkdir -p /mnt/src /mnt/old /tmp/keep
	# The eMMC: the one MMC (not SD) disk.
	EMMC=""
	for d in $(disks); do [ "$(disktype "$d")" = MMC ] && EMMC="$d"; done
	log "LightMoss updater, $(date)"
	log "cmdline: $(cat /proc/cmdline)"
	log "system disk: ${ROOTDISK:-none} ($ROOTSPEC), eMMC: ${EMMC:-none}"
	for d in $(disks); do log "disk $d: $(disktype "$d"), signature $(disksig "$(dev "$d")")"; done

	# The system's BOOT says which disk: lightmoss-update there (the app)
	# means the system's own; otherwise the eMMC. lightmoss-debug there carries
	# over to the updated disk, so it starts with kernel text on the screen and
	# exports its own logs. (rw: an image may be on that same partition.)
	SELF=0; DEBUG=0
	if [ -n "$ROOTDISK" ] && mount -t vfat -o rw "$(part "$ROOTDISK" 1)" /mnt/old 2>/dev/null; then
		[ -e "/mnt/old/$SELF_TRIGGER" ] && SELF=1
		[ -e /mnt/old/lightmoss-debug ] && DEBUG=1
		umount /mnt/old
	fi
	[ "$SELF" = 1 ] && ACTIVE=1
	if [ "$SELF" = 1 ]; then
		TARGET="$ROOTDISK"
	elif [ -n "$EMMC" ]; then
		TARGET="$EMMC"
	else
		log "no internal eMMC and no lightmoss-update: nothing to install to"
		return 0
	fi
	if [ "$(disktype "$TARGET")" = MMC ]; then NAME="the internal eMMC"; else NAME="the card in TF1"; fi
	T1="$(part "$TARGET" 1)"; T2="$(part "$TARGET" 2)"
	log "target: $TARGET ($NAME), in place: $SELF"

	# What the write will cover: up to the end of the target's LightMoss
	# system partition when it holds LightMoss (an update keeps that layout,
	# and SPRUCEOS behind it), the whole disk otherwise.
	TEND=""
	if [ "$(label "$T1")" = BOOT ] && [ "$(label "$T2")" = LIGHTMOSS ]; then
		TEND=$(($(pstart "$TARGET" "$T2") + $(psize "$TARGET" "$T2")))
	fi

	# Look for *.rkimg (any case) at the root of every FAT32/exFAT partition
	# of every card: a plain card in TF1, the LightMoss card's BOOT or
	# SPRUCEOS, the spruce card in TF2, but nowhere on the target that is
	# about to be overwritten. A file of that name that is not an image (a
	# placeholder) is passed over.
	IMG=""; NOTIMAGE=""
	for d in $(disks); do
		for p in $(parts "$d"); do
			if [ "$d" = "$TARGET" ]; then
				[ -n "$TEND" ] || continue
				[ "$(pstart "$d" "$p")" -ge "$TEND" ] || continue
			fi
			mount -t vfat -o rw "$p" /mnt/src 2>/dev/null ||
				mount -t exfat -o rw "$p" /mnt/src 2>/dev/null || continue
			for f in /mnt/src/*.[rR][kK][iI][mM][gG]; do
				[ -f "$f" ] || continue
				if is_image "$f"; then
					IMG="$f"
					log "image: $p/${f##*/}, $(wc -c < "$f") bytes"
					break 3
				fi
				# Not a compressed release image (an uncompressed .img, a
				# partial copy...): set aside, once, and say so below.
				mv "$f" "$f.bad"
				log "$p/${f##*/} is not a compressed LightMoss image (.img.xz): set aside as .bad"
				NOTIMAGE="${f##*/}"
			done
			umount /mnt/src
		done
	done
	if [ -z "$IMG" ] && [ -n "$NOTIMAGE" ]; then
		ACTIVE=1
		give_up "$NOTIMAGE is not a compressed LightMoss release image (lightmoss-r36s-<version>.img.xz renamed .rkimg), so it was set aside as $NOTIMAGE.bad."
		return 1
	fi
	if [ -z "$IMG" ]; then
		# Nothing to install: a plain start, unless the app asked for one.
		[ "$SELF" = 1 ] || { log "no .rkimg found"; return 0; }
		give_up "The LightMoss update (an .rkimg file) is no longer on any card."
		return 1
	fi
	ACTIVE=1
	RKIMG="${IMG##*/}"

	# xz's own checksum, over the whole file, before anything is written.
	say "Checking $RKIMG..."
	xz -t "$IMG" || { give_up "$RKIMG is damaged (set aside as $RKIMG.bad)."; return 1; }

	# Its partition table: p1 (BOOT) and p2 (system), start and size.
	xz -dc "$IMG" | dd bs=512 count=1 of=/tmp/new.mbr 2>/dev/null
	[ "$(od -An -tx1 -j 510 -N 2 /tmp/new.mbr | tr -d ' \n')" = 55aa ] ||
		{ give_up "$RKIMG is not a LightMoss image (set aside as $RKIMG.bad)."; return 1; }
	geom() { od -An -tu4 -j "$2" -N 8 "$1" | tr -s ' ' | sed 's/^ //'; }
	NEW1="$(geom /tmp/new.mbr 454)"; NEW2="$(geom /tmp/new.mbr 470)"
	IMGEND=$(( (${NEW2% *} + ${NEW2#* }) * 512 ))
	dd if="$(dev "$TARGET")" bs=512 count=1 of=/tmp/old.mbr 2>/dev/null
	OLD1="$(geom /tmp/old.mbr 454)"; OLD2="$(geom /tmp/old.mbr 470)"
	log "image partitions  (start size): p1 $NEW1, p2 $NEW2"
	log "target partitions (start size): p1 $OLD1, p2 $OLD2"

	MODE=install
	if [ -n "$TEND" ]; then
		[ "$NEW1" = "$OLD1" ] && [ "$NEW2" = "$OLD2" ] || {
			if [ "$SELF" = 1 ]; then
				give_up "This LightMoss lays the disk out differently from the one installed, so it cannot update it in place. Flash it instead (set aside as $RKIMG.bad)."
			else
				give_up "This image lays the eMMC out differently from the installed LightMoss. Install it with lightmoss-install-emmc --wipe instead (set aside as $RKIMG.bad)."
			fi
			return 1; }
		MODE=update
	elif [ "$SELF" = 1 ]; then
		give_up "The system's disk does not hold LightMoss as expected, so it cannot be updated in place."
		return 1
	fi
	log "target labels: p1 '$(label "$T1")', p2 '$(label "$T2")'; mode: $MODE"

	# Keep what makes the installed system this device's.
	if [ "$MODE" = update ]; then
		TSIG="$(disksig "$(dev "$TARGET")")"
		if mount -o ro "$T2" /mnt/old; then
			cp -a /mnt/old/etc/machine-id /tmp/keep/ 2>/dev/null
			[ -d /mnt/old/etc/dropbear ] && cp -a /mnt/old/etc/dropbear /tmp/keep/
			umount /mnt/old
		fi
		if mount -o ro "$T1" /mnt/old; then
			[ -e /mnt/old/headphones-invert ] && touch /tmp/keep/headphones-invert
			[ -e /mnt/old/lightmoss-debug ] && DEBUG=1
			# The Panel 9 swap of R36S-PANEL.txt: keep U-Boot starting on Panel 9.
			cmp -s /mnt/old/uboot.dtb /mnt/old/uboot-panel9.dtb 2>/dev/null && touch /tmp/keep/panel9
			umount /mnt/old
		fi
	fi

	# Write, then read it back from the disk and compare, so that a failing
	# card or eMMC does not go unnoticed. One more try if they differ. (Before
	# the partition table below is put back: that changes the first sector.)
	# Should it come to that, an update puts the target's own partition table
	# back before stopping: SPRUCEOS stays listed and the disk keeps its own
	# signature (the image's would clash with a LightMoss card) for a retry.
	put_table_back() {
		[ "$MODE" = update ] &&
			dd if=/tmp/old.mbr of="$(dev "$TARGET")" bs=512 count=1 conv=notrunc,fsync 2>/dev/null
	}
	try=1
	while :; do
		say "Installing LightMoss ($RKIMG) on $NAME. Do not power off. This takes a few minutes."
		write_image || { put_table_back
			fail "Writing $NAME failed: $(tail -n 1 /tmp/dd.log). Start from a LightMoss card in TF1 to repair it."; }
		say "Checking what was written to $NAME..."
		GOT="$(readback "$(dev "$TARGET")" "$BYTES")"
		log "read back: sha256 $GOT"
		[ "$GOT" = "$WANT" ] && break
		[ "$try" -ge 2 ] && { put_table_back
			fail "What was written to $NAME does not read back as $RKIMG, twice: $NAME may be failing. Start from a LightMoss card in TF1 to repair it, or try another card."; }
		log "read back differs; writing again"
		try=$((try + 1))
	done
	log "written and verified"
	if [ "$MODE" = update ]; then
		# The target's own partition table: SPRUCEOS and the disk signature.
		dd if=/tmp/old.mbr of="$(dev "$TARGET")" bs=512 count=1 conv=notrunc,fsync 2>/dev/null
	else
		# A disk signature of its own, so it never shares a PARTUUID with a
		# LightMoss card: four random bytes in place of the image's "LM36".
		while :; do
			dd if=/dev/urandom of="$(dev "$TARGET")" bs=1 seek=440 count=4 conv=notrunc,fsync 2>/dev/null
			TSIG="$(disksig "$(dev "$TARGET")")"
			[ "$TSIG" != 4c4d3336 ] && [ "$TSIG" != 00000000 ] && break
		done
	fi
	blockdev --rereadpt "$(dev "$TARGET")" 2>/dev/null
	sleep 1

	mount -o rw "$T1" /mnt/old || fail "Cannot mount the new BOOT."
	sed -i "s/root=PARTUUID=[0-9a-f]*-02/root=PARTUUID=$TSIG-02/" /mnt/old/boot.ini
	log "signature: $TSIG; boot.ini: $(grep -o 'root=PARTUUID=[0-9a-f-]*' /mnt/old/boot.ini)"
	[ -e /tmp/keep/headphones-invert ] && touch /mnt/old/headphones-invert
	[ "$DEBUG" = 1 ] && touch /mnt/old/lightmoss-debug && log "lightmoss-debug kept"
	[ -e /tmp/keep/panel9 ] && cp /mnt/old/uboot-panel9.dtb /mnt/old/uboot.dtb
	umount /mnt/old
	if [ "$MODE" = update ] && mount -o rw "$T2" /mnt/old; then
		[ -e /tmp/keep/machine-id ] && cp -a /tmp/keep/machine-id /mnt/old/etc/machine-id
		if [ -d /tmp/keep/dropbear ]; then
			rm -rf /mnt/old/etc/dropbear
			cp -a /tmp/keep/dropbear /mnt/old/etc/dropbear
		fi
		# First boot runs again: it leaves an existing SPRUCEOS as it is,
		# and adds it to a disk that never got that far.
		umount /mnt/old
	fi

	mv "$IMG" "$IMG.done"
	umount /mnt/src 2>/dev/null
	clear_trigger
	say "LightMoss is installed on $NAME ($MODE). Restarting..."
	savelog
	sync
	sleep 3
	reboot -f
}

# Every start: with the charger, look for an update and install it; without,
# start at once, with a reminder if the LightMoss Update app has one waiting.
check_for_update() {
	mkdir -p /mnt/src /mnt/old
	if charger_online; then
		settle_disks
		update
		return
	fi
	if [ -n "$ROOTDISK" ] && mount -t vfat -o ro "$(part "$ROOTDISK" 1)" /mnt/old 2>/dev/null; then
		waiting=0
		[ -e "/mnt/old/$SELF_TRIGGER" ] && waiting=1
		umount /mnt/old
		if [ "$waiting" = 1 ]; then
			say "A LightMoss update is waiting. Connect the charger and restart to install it. Starting without it..."
			sleep 5
		fi
	fi
}

# What a start does before handing over to the system. The log goes to BOOT
# only when there was something to do.
updater_main() {
	ACTIVE=0
	check_for_update
	umount /mnt/src 2>/dev/null
	[ "$ACTIVE" = 1 ] && savelog
}

[ -n "$LM_UPDATER_TEST" ] && return 0
updater_main
boot_system
