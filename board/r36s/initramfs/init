#!/bin/sh
# LightMoss updater (initramfs).
#
# U-Boot boots with this initramfs only when an update is waiting (boot.ini):
# a file named LightMoss.rkimg on TF1's first partition (a plain FAT32 card is
# enough), or an empty lightmoss-install there or on the system's BOOT (for an
# image U-Boot cannot see: too big for BOOT, on the spruce card in TF2, on
# exFAT), or an empty lightmoss-update on the system's BOOT (the LightMoss
# Update app). LightMoss.rkimg is a LightMoss image, as released (.img.xz) or
# uncompressed (.img), renamed; it is looked for on every FAT32/exFAT
# partition of every card, but never where it is about to be written.
#
# Where it goes, which nothing has mounted yet: with lightmoss-update, the
# disk the system runs from (the eMMC or the card in TF1), updated in place;
# otherwise the internal eMMC:
#  - a disk that already holds LightMoss is updated: the loader, BOOT and the
#    system partition are rewritten; the partition table, SPRUCEOS (spruce on
#    it), the disk signature, the machine ID, the SSH host keys, the panel
#    choice (uboot.dtb), headphones-invert and lightmoss-debug stay;
#  - anything else on the eMMC (EmuELEC) is replaced by a fresh install.
# Only with the charger connected: a write cut short leaves no system there
# (a LightMoss card in TF1 still boots, and can repair it).
#
# Afterwards the file is renamed LightMoss.rkimg.done and the device restarts.
# Without the charger it says so, boots as usual and tries again next time;
# with an image it cannot use, it sets it aside (LightMoss.rkimg.bad) and
# boots as usual. Either way, what it did goes to lightmoss-update.log on the
# BOOT partition it was started from.

# LM_UPDATER_TEST=1: only define the functions (board/r36s/test-updater.sh
# sources this file and runs update() against disk images).
if [ -z "$LM_UPDATER_TEST" ]; then
	export PATH=/bin
	/bin/busybox --install -s /bin 2>/dev/null
	mkdir -p /dev /proc /sys /tmp /mnt /newroot
	mount -t devtmpfs devtmpfs /dev
	mount -t proc proc /proc
	mount -t sysfs sysfs /sys
	exec </dev/console >/dev/console 2>&1
fi

RKIMG=LightMoss.rkimg
TTY=/dev/tty1

LOG=/tmp/update.log

# On the screen and in the log.
say() {
	echo "lightmoss-update: $*"
	echo "$*" >> "$LOG"
	printf '\033[2J\033[H\n\n  LightMoss update\n\n  %s\n' "$*" > "$TTY" 2>/dev/null
}

# In the log only.
log() { echo "$*" >> "$LOG"; }

cmdline() { sed -n "s/.*\\b$1=\\([^ ]*\\).*/\\1/p" /proc/cmdline; }

part() { case "$1" in *[0-9]) echo "/dev/${1}p$2" ;; *) echo "/dev/$1$2" ;; esac; }

# MBR disk signature of a whole disk, as PARTUUID writes it (8 hex digits).
disksig() { od -An -tx4 -j 440 -N 4 "$1" 2>/dev/null | tr -d ' \n'; }

disks() {
	for d in /sys/block/mmcblk*; do
		n="${d##*/}"
		case "$n" in *boot*|*rpmb*) continue ;; esac
		[ -e "$d" ] && echo "$n"
	done
}

disktype() { cat "/sys/block/$1/device/type" 2>/dev/null; }

# A whole disk's device node, its partitions' nodes, and a partition's start
# and size in sectors (disk, partition node). The test harness replaces these.
dev() { echo "/dev/$1"; }
parts() { for p in /dev/"$1"p*; do [ -b "$p" ] && echo "$p"; done; }
pstart() { cat "/sys/block/$1/${2#/dev/}/start"; }
psize() { cat "/sys/block/$1/${2#/dev/}/size"; }

# A charger (or any power source) connected.
charger_online() {
	for f in /sys/class/power_supply/*/online; do
		[ "$(cat "$f" 2>/dev/null)" = 1 ] && return 0
	done
	return 1
}

# busybox blkid: /dev/x: LABEL="BOOT" UUID="..."
label() { blkid "$1" 2>/dev/null | sed -n 's/.*LABEL="\([^"]*\)".*/\1/p'; }

# The empty files that ask for an update, read by boot.ini too:
#  - lightmoss-install (TF1's first partition, or the system's BOOT): the image
#    goes on the internal eMMC, for an image U-Boot cannot see itself (too big
#    for BOOT, on the spruce card in TF2, on exFAT);
#  - lightmoss-update (the system's BOOT; the LightMoss Update app sets it):
#    the disk the system runs from, the eMMC or the card in TF1, is updated in
#    place.
TRIGGER=lightmoss-install
SELF_TRIGGER=lightmoss-update

# A LightMoss image: xz-compressed (as released), or raw (an MBR).
is_image() {
	[ "$(od -An -tx1 -N 6 "$1" | tr -d ' \n')" = fd377a585a00 ] ||
		[ "$(od -An -tx1 -j 510 -N 2 "$1" | tr -d ' \n')" = 55aa ]
}

# Remove the triggers from partition 1 of every disk, so they fire once.
clear_trigger() {
	mkdir -p /mnt/flag
	for d in $(disks); do
		p="$(part "$d" 1)"
		parts "$d" | grep -qx "$p" || continue
		mount -t vfat -o rw "$p" /mnt/flag 2>/dev/null || continue
		rm -f "/mnt/flag/$TRIGGER" "/mnt/flag/$SELF_TRIGGER"
		umount /mnt/flag
	done
}

# An update that cannot go ahead with this image at all: say why, set the
# image aside (LightMoss.rkimg.bad) and clear the triggers, so the next start
# is a plain one rather than the same error again.
give_up() {
	say "$1 Starting without it..."
	[ -n "$IMG" ] && mv "$IMG" "$IMG.bad" 2>/dev/null
	umount /mnt/src 2>/dev/null
	clear_trigger
	sleep 12
	return 1
}

# ---------------------------------------------------------------- root disk --
if [ -z "$LM_UPDATER_TEST" ]; then
	ROOTSPEC="$(cmdline root)"
	SIG="${ROOTSPEC#PARTUUID=}"; SIG="${SIG%-*}"
	ROOTDISK=""
	n=0
	while [ -z "$ROOTDISK" ] && [ "$n" -lt 50 ]; do
		for d in $(disks); do
			[ "$(disksig "$(dev "$d")")" = "$SIG" ] && ROOTDISK="$d" && break
		done
		[ -n "$ROOTDISK" ] || { sleep 0.2; n=$((n + 1)); }
	done
fi

# The log, to BOOT on the disk the system was started from (the LightMoss card
# in TF1, as a rule), as lightmoss-update.log.
savelog() {
	[ -n "$ROOTDISK" ] || return 0
	mkdir -p /mnt/log
	mount -t vfat -o rw "$(part "$ROOTDISK" 1)" /mnt/log 2>/dev/null || return 0
	cp "$LOG" /mnt/log/lightmoss-update.log
	sync
	umount /mnt/log
}

# Something went wrong past the point of starting the system: say so and stay.
fail() {
	say "$*"
	savelog
	while :; do sleep 60; done
}

boot_system() {
	if [ -z "$ROOTDISK" ]; then
		say "No LightMoss system found (root=$ROOTSPEC). Power off and check the cards."
		while :; do sleep 60; done
	fi
	mount -t ext4 -o ro "$(part "$ROOTDISK" 2)" /newroot || {
		say "Cannot mount $(part "$ROOTDISK" 2)."
		while :; do sleep 60; done
	}
	umount /proc /sys 2>/dev/null
	mount --move /dev /newroot/dev
	exec switch_root /newroot /sbin/init
}

# -------------------------------------------------------------- the update --
update() {
	mkdir -p /mnt/src /mnt/old /tmp/keep
	# The eMMC: the one MMC (not SD) disk.
	EMMC=""
	for d in $(disks); do [ "$(disktype "$d")" = MMC ] && EMMC="$d"; done
	log "LightMoss updater, $(date)"
	log "cmdline: $(cat /proc/cmdline)"
	log "system disk: ${ROOTDISK:-none} ($ROOTSPEC), eMMC: ${EMMC:-none}"
	for d in $(disks); do log "disk $d: $(disktype "$d"), signature $(disksig "$(dev "$d")")"; done

	# The system's BOOT says which disk: lightmoss-update there means the
	# system's own; otherwise the eMMC. lightmoss-debug there carries over
	# to the updated disk, so it starts with kernel text on the screen and
	# exports its own logs. (rw: the image may be on that same partition.)
	SELF=0; DEBUG=0
	if [ -n "$ROOTDISK" ] && mount -t vfat -o rw "$(part "$ROOTDISK" 1)" /mnt/old 2>/dev/null; then
		[ -e "/mnt/old/$SELF_TRIGGER" ] && SELF=1
		[ -e /mnt/old/lightmoss-debug ] && DEBUG=1
		umount /mnt/old
	fi
	if [ "$SELF" = 1 ]; then
		TARGET="$ROOTDISK"
	else
		[ -n "$EMMC" ] || { IMG=""; give_up "This device has no internal eMMC: nothing to install."; return 1; }
		TARGET="$EMMC"
	fi
	if [ "$(disktype "$TARGET")" = MMC ]; then NAME="the internal eMMC"; else NAME="the card in TF1"; fi
	T1="$(part "$TARGET" 1)"; T2="$(part "$TARGET" 2)"
	log "target: $TARGET ($NAME), in place: $SELF"

	# What the write will cover: up to the end of the target's LightMoss
	# system partition when it holds LightMoss (an update keeps that layout,
	# and SPRUCEOS behind it), the whole disk otherwise.
	TEND=""
	if [ "$(label "$T1")" = BOOT ] && [ "$(label "$T2")" = LIGHTMOSS ]; then
		TEND=$(($(pstart "$TARGET" "$T2") + $(psize "$TARGET" "$T2")))
	fi

	# Find the image on any FAT32/exFAT partition of any card: a plain card in
	# TF1, the LightMoss card's BOOT or SPRUCEOS, the spruce card in TF2, but
	# nowhere on the target that is about to be overwritten. A file of that
	# name that is not an image (a placeholder) is passed over.
	IMG=""
	for d in $(disks); do
		for p in $(parts "$d"); do
			if [ "$d" = "$TARGET" ]; then
				[ -n "$TEND" ] || continue
				[ "$(pstart "$d" "$p")" -ge "$TEND" ] || continue
			fi
			mount -t vfat -o rw "$p" /mnt/src 2>/dev/null ||
				mount -t exfat -o rw "$p" /mnt/src 2>/dev/null || continue
			if [ -f "/mnt/src/$RKIMG" ] && is_image "/mnt/src/$RKIMG"; then
				IMG="/mnt/src/$RKIMG"
				log "image: $p/$RKIMG, $(wc -c < "$IMG") bytes"
				break 2
			fi
			[ -e "/mnt/src/$RKIMG" ] && log "$p/$RKIMG is not an image, passed over"
			umount /mnt/src
		done
	done
	if [ -z "$IMG" ]; then
		give_up "No $RKIMG found on any card. Copy it to a card and try again."
		return 1
	fi

	# Only on the charger. The update stays waiting for the next start.
	if ! charger_online; then
		say "An update is waiting ($RKIMG). Connect the charger and restart to install it. Starting without it..."
		sleep 8
		return 1
	fi

	# Compressed (as released) or not.
	if [ "$(od -An -tx1 -N 6 "$IMG" | tr -d ' \n')" = fd377a585a00 ]; then
		say "Checking $RKIMG..."
		xz -t "$IMG" || { give_up "$RKIMG is damaged (set aside as $RKIMG.bad)."; return 1; }
		CAT="xz -dc"
	else
		CAT="cat"
	fi

	# Its partition table: p1 (BOOT) and p2 (system), start and size.
	$CAT "$IMG" | dd bs=512 count=1 of=/tmp/new.mbr 2>/dev/null
	[ "$(od -An -tx1 -j 510 -N 2 /tmp/new.mbr | tr -d ' \n')" = 55aa ] ||
		{ give_up "$RKIMG is not a LightMoss image (set aside as $RKIMG.bad)."; return 1; }
	geom() { od -An -tu4 -j "$2" -N 8 "$1" | tr -s ' ' | sed 's/^ //'; }
	NEW1="$(geom /tmp/new.mbr 454)"; NEW2="$(geom /tmp/new.mbr 470)"
	dd if="$(dev "$TARGET")" bs=512 count=1 of=/tmp/old.mbr 2>/dev/null
	OLD1="$(geom /tmp/old.mbr 454)"; OLD2="$(geom /tmp/old.mbr 470)"
	log "image partitions  (start size): p1 $NEW1, p2 $NEW2"
	log "target partitions (start size): p1 $OLD1, p2 $OLD2"

	MODE=install
	if [ -n "$TEND" ]; then
		[ "$NEW1" = "$OLD1" ] && [ "$NEW2" = "$OLD2" ] || {
			if [ "$SELF" = 1 ]; then
				give_up "This LightMoss lays the disk out differently from the one installed, so it cannot update it in place. Flash it instead (set aside as $RKIMG.bad)."
			else
				give_up "This image lays the eMMC out differently from the installed LightMoss. Install it with lightmoss-install-emmc --wipe instead (set aside as $RKIMG.bad)."
			fi
			return 1; }
		MODE=update
	elif [ "$SELF" = 1 ]; then
		give_up "The system's disk does not hold LightMoss as expected, so it cannot be updated in place."
		return 1
	fi
	log "target labels: p1 '$(label "$T1")', p2 '$(label "$T2")'; mode: $MODE"

	# Keep what makes the installed system this device's.
	if [ "$MODE" = update ]; then
		TSIG="$(disksig "$(dev "$TARGET")")"
		if mount -o ro "$T2" /mnt/old; then
			cp -a /mnt/old/etc/machine-id /tmp/keep/ 2>/dev/null
			[ -d /mnt/old/etc/dropbear ] && cp -a /mnt/old/etc/dropbear /tmp/keep/
			umount /mnt/old
		fi
		if mount -o ro "$T1" /mnt/old; then
			[ -e /mnt/old/headphones-invert ] && touch /tmp/keep/headphones-invert
			[ -e /mnt/old/lightmoss-debug ] && DEBUG=1
			# The Panel 9 swap of R36S-PANEL.txt: keep U-Boot starting on Panel 9.
			cmp -s /mnt/old/uboot.dtb /mnt/old/uboot-panel9.dtb 2>/dev/null && touch /tmp/keep/panel9
			umount /mnt/old
		fi
	fi

	say "Installing LightMoss on $NAME. Do not power off. This takes a few minutes."
	# (notrunc: a no-op on a disk, but the test harness writes into a file.)
	$CAT "$IMG" | dd of="$(dev "$TARGET")" bs=1M conv=notrunc,fsync 2>/tmp/dd.log ||
		fail "Writing $NAME failed: $(tail -n 1 /tmp/dd.log). Start from a LightMoss card in TF1 to repair it."
	log "written: $(tr '\n' ' ' < /tmp/dd.log)"
	if [ "$MODE" = update ]; then
		# The target's own partition table: SPRUCEOS and the disk signature.
		dd if=/tmp/old.mbr of="$(dev "$TARGET")" bs=512 count=1 conv=notrunc,fsync 2>/dev/null
	else
		# A disk signature of its own, so it never shares a PARTUUID with a
		# LightMoss card: four random bytes in place of the image's "LM36".
		while :; do
			dd if=/dev/urandom of="$(dev "$TARGET")" bs=1 seek=440 count=4 conv=notrunc,fsync 2>/dev/null
			TSIG="$(disksig "$(dev "$TARGET")")"
			[ "$TSIG" != 4c4d3336 ] && [ "$TSIG" != 00000000 ] && break
		done
	fi
	blockdev --rereadpt "$(dev "$TARGET")" 2>/dev/null
	sleep 1

	mount -o rw "$T1" /mnt/old || fail "Cannot mount the new BOOT."
	sed -i "s/root=PARTUUID=[0-9a-f]*-02/root=PARTUUID=$TSIG-02/" /mnt/old/boot.ini
	log "signature: $TSIG; boot.ini: $(grep -o 'root=PARTUUID=[0-9a-f-]*' /mnt/old/boot.ini)"
	[ -e /tmp/keep/headphones-invert ] && touch /mnt/old/headphones-invert
	[ "$DEBUG" = 1 ] && touch /mnt/old/lightmoss-debug && log "lightmoss-debug kept"
	[ -e /tmp/keep/panel9 ] && cp /mnt/old/uboot-panel9.dtb /mnt/old/uboot.dtb
	umount /mnt/old
	if [ "$MODE" = update ] && mount -o rw "$T2" /mnt/old; then
		[ -e /tmp/keep/machine-id ] && cp -a /tmp/keep/machine-id /mnt/old/etc/machine-id
		if [ -d /tmp/keep/dropbear ]; then
			rm -rf /mnt/old/etc/dropbear
			cp -a /tmp/keep/dropbear /mnt/old/etc/dropbear
		fi
		# First boot runs again: it leaves an existing SPRUCEOS as it is,
		# and adds it to a disk that never got that far.
		umount /mnt/old
	fi

	mv "$IMG" "$IMG.done"
	umount /mnt/src 2>/dev/null
	clear_trigger
	say "LightMoss is installed on $NAME ($MODE). Restarting..."
	savelog
	sync
	sleep 3
	reboot -f
}

[ -n "$LM_UPDATER_TEST" ] && return 0
if grep -qw lightmoss.rkimg /proc/cmdline; then
	update
	umount /mnt/src 2>/dev/null
	savelog
fi
boot_system
