From 356e48509283f8c0171a0bafbf3500c4109298ed Mon Sep 17 00:00:00 2001
From: LightMoss <lightmoss@localhost>
Date: Sat, 21 Nov 2026 07:57:28 +0000
Subject: [PATCH 6/6] arm64: dts: rockchip: rk3326-r36sclone: opt-in CPU overclock
 dtbs

rk3326-r36sclone-linux-oc and rk3326-r36sclone-panel9-linux-oc are the
two G80CA dtbs plus rk3326-r36sclone-overclock.dtsi, which LightMoss's
boot.ini loads, with max_cpufreq=1512 boot_cpufreq=1296, only when the
owner opts in (lightmoss-cpu-overclock on BOOT). The CPU then runs at
the rates spruce's CPU modes ask for, 1416 and 1512 MHz, at 1.4 V as
dArkOSen's overclock does; the plain dtbs keep Rockchip's tables, which
hold it at 1248/1296 MHz. Run at 1.35 V, 1416 MHz froze a tested unit.

The 1416 and 1512 MHz OPPs get 1.4 V on every PVTM level. The ceiling
rockchip,max-volt is one PMIC step above (1.4125 V) so that no OPP is at
it and rockchip_adjust_opp_by_irdrop() sets no safe rate (at 1.4 V it
would clamp the PLL at 1416 MHz), and rockchip,boot-max-freq lets
max_cpufreq=1512 pick the PLL scale for 1512 MHz. Nothing runs above
1.4 V: vdd_arm's regulator stops at 1.4 V and the low-temperature boost,
which raises OPPs up to the ceiling below 0 C, is left out.
---
 arch/arm64/boot/dts/rockchip/Makefile         |  2 +
 .../rockchip/rk3326-r36sclone-linux-oc.dts    |  5 ++
 .../rockchip/rk3326-r36sclone-overclock.dtsi  | 49 +++++++++++++++++++
 .../rk3326-r36sclone-panel9-linux-oc.dts      |  5 ++
 4 files changed, 61 insertions(+)
 create mode 100644 arch/arm64/boot/dts/rockchip/rk3326-r36sclone-linux-oc.dts
 create mode 100644 arch/arm64/boot/dts/rockchip/rk3326-r36sclone-overclock.dtsi
 create mode 100644 arch/arm64/boot/dts/rockchip/rk3326-r36sclone-panel9-linux-oc.dts

diff --git a/arch/arm64/boot/dts/rockchip/Makefile b/arch/arm64/boot/dts/rockchip/Makefile
index 957412c14..edd8f103e 100644
--- a/arch/arm64/boot/dts/rockchip/Makefile
+++ b/arch/arm64/boot/dts/rockchip/Makefile
@@ -93,6 +93,8 @@ dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3326-r36s-type2-panel2-linux.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3326-r36s-v21-linux.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3326-r36sclone-linux.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3326-r36sclone-panel9-linux.dtb
+dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3326-r36sclone-linux-oc.dtb
+dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3326-r36sclone-panel9-linux-oc.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3326-r36splus-linux.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3326-r36t-linux.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3326-r36tmax-linux.dtb
diff --git a/arch/arm64/boot/dts/rockchip/rk3326-r36sclone-linux-oc.dts b/arch/arm64/boot/dts/rockchip/rk3326-r36sclone-linux-oc.dts
new file mode 100644
index 000000000..0423c3ac2
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3326-r36sclone-linux-oc.dts
@@ -0,0 +1,5 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/* LightMoss: rk3326-r36sclone-linux (Panel 8) with the opt-in CPU overclock. */
+
+#include "rk3326-r36sclone-linux.dts"
+#include "rk3326-r36sclone-overclock.dtsi"
diff --git a/arch/arm64/boot/dts/rockchip/rk3326-r36sclone-overclock.dtsi b/arch/arm64/boot/dts/rockchip/rk3326-r36sclone-overclock.dtsi
new file mode 100644
index 000000000..45d8c5ee2
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3326-r36sclone-overclock.dtsi
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * LightMoss: opt-in CPU overclock for the R36S clone (G80CA), on top of
+ * rk3326-r36sclone-linux.dts or its panel9 variant: the CPU runs at the
+ * rates spruce's CPU modes ask for, 1416 MHz (Smart, Performance) and
+ * 1512 MHz (Overclock), at 1.4 V, as dArkOSen's overclock runs them.
+ * LightMoss's boot.ini loads these dtbs, with max_cpufreq=1512
+ * boot_cpufreq=1296, only when lightmoss-cpu-overclock is on BOOT.
+ *
+ * Without it the kernel holds the CPU at 1248/1296 MHz while cpufreq
+ * reports the higher rates: at the 1.35 V ceiling
+ * rockchip_adjust_opp_by_irdrop() takes the first OPP at 1.35 V as the safe
+ * rate and bin-scaling-sel gives PLL scale 13 (1296 MHz). Run for real at
+ * 1.35 V, 1416 MHz froze a tested unit, hence 1.4 V here.
+ */
+
+&cpu0_opp_table {
+	/*
+	 * One PMIC step above the 1.4 V OPPs, so that no OPP is at the
+	 * ceiling and rockchip_adjust_opp_by_irdrop() sets no safe rate (it
+	 * would clamp the PLL at 1416 MHz, the first OPP at it). Nothing runs
+	 * above 1.4 V: vdd_arm stops there, and the low-temperature boost,
+	 * which raises OPPs up to this ceiling below 0 C, is left out.
+	 */
+	rockchip,max-volt = <1412500>;
+	/delete-property/ rockchip,low-temp-adjust-volt;
+	/* With max_cpufreq=1512: the PLL scale for 1512 MHz, not 13. */
+	rockchip,boot-max-freq = <1296000000>;
+
+	opp-1416000000 {
+		opp-microvolt = <1400000 1400000 1400000>;
+		opp-microvolt-L0 = <1400000 1400000 1400000>;
+		opp-microvolt-L1 = <1400000 1400000 1400000>;
+		opp-microvolt-L2 = <1400000 1400000 1400000>;
+		opp-microvolt-L3 = <1400000 1400000 1400000>;
+	};
+
+	opp-1512000000 {
+		opp-microvolt = <1400000 1400000 1400000>;
+		opp-microvolt-L0 = <1400000 1400000 1400000>;
+		opp-microvolt-L1 = <1400000 1400000 1400000>;
+		opp-microvolt-L2 = <1400000 1400000 1400000>;
+		opp-microvolt-L3 = <1400000 1400000 1400000>;
+	};
+};
+
+&vdd_arm {
+	regulator-max-microvolt = <1400000>;
+};
diff --git a/arch/arm64/boot/dts/rockchip/rk3326-r36sclone-panel9-linux-oc.dts b/arch/arm64/boot/dts/rockchip/rk3326-r36sclone-panel9-linux-oc.dts
new file mode 100644
index 000000000..207985cc5
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3326-r36sclone-panel9-linux-oc.dts
@@ -0,0 +1,5 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/* LightMoss: rk3326-r36sclone-panel9-linux with the opt-in CPU overclock. */
+
+#include "rk3326-r36sclone-panel9-linux.dts"
+#include "rk3326-r36sclone-overclock.dtsi"
