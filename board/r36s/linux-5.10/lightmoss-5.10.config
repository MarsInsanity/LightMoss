# LightMoss: changes on top of clone_defconfig (jokubasver/rockchip-kernel,
# branch arkos4clone-5.10) for the R36S clone G80CA, where this 5.10 kernel
# is the optional second kernel next to the 4.4 one. It carries over
# board/r36s/linux/lightmoss.config (the 4.4 fragment) where it applies:
# only what the G80CA has, and what systemd, NetworkManager and spruce need,
# is kept. Every line here survives olddefconfig.

CONFIG_LOCALVERSION="-lightmoss"
# CONFIG_LOCALVERSION_AUTO is not set

# --- built in for the updater initramfs (=y, never =m) ------------------------
# boot.ini always loads uInitrd: a gzip'd newc cpio (mkimage ramdisk) with
# busybox and no kernel modules. It mounts devtmpfs, reads
# /sys/block/mmcblk*/device/type and /sys/class/power_supply/*/online,
# mounts vfat/exfat/ext4 partitions of both SD slots and the eMMC, writes
# its messages to /dev/tty1, then switch_roots to the ext4 root.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# All three PX30 MMC controllers (TF1, TF2, eMMC) are dw_mmc; there is no
# SDHCI on this SoC. The PMIC's regulators and the I/O domains set the SD
# card voltages.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_MFD_RK808=y
CONFIG_REGULATOR_RK808=y
CONFIG_I2C_RK3X=y
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
# spruce's card is FAT32 or exFAT; the codepage and iocharset are the 4.4
# kernel's (936 and utf8), and vfat needs the default codepage's NLS table
# built in to mount.
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=936
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_EXFAT_FS=y
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"
CONFIG_EXT4_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_CODEPAGE_936=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
# The charger check (power_supply/*/online).
CONFIG_BATTERY_RK817=y
CONFIG_CHARGER_RK817=y
# The screen: DSI panel, its PHY, the backlight, and the fbdev console on tty1.
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# The buttons: the joypad (GPIO buttons, SARADC sticks) and the volume keys.
CONFIG_INPUT_EVDEV=y
CONFIG_JOYSTICK_ODROIDGO3=y
CONFIG_KEYBOARD_ADC=y
CONFIG_IIO=y
CONFIG_ROCKCHIP_SARADC=y

# --- Mali G31 with the g29p1 userspace driver (GLES and Vulkan) ---------------
CONFIG_MALI_BIFROST=y
CONFIG_MALI_PLATFORM_NAME="rk"
CONFIG_MALI_BIFROST_DEVFREQ=y
# libmali g29p1 allocates its buffers from the DMA-BUF system heap
# (/dev/dma_heap/system; arkos4clone's 70-mali-dma-heap.rules opens it to
# the video group).
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y

# --- systemd 257 -----------------------------------------------------------------
# boot.ini forces the v1 cgroup hierarchy (systemd.unified_cgroup_hierarchy=0
# SYSTEMD_CGROUP_ENABLE_LEGACY_FORCE=1), as for the 4.4 kernel, so the v1
# controllers stay; cgroup v2 (CGROUP_BPF) works on this kernel too.
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS_FS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# CONFIG_UEVENT_HELPER is not set
# CONFIG_FW_LOADER_USER_HELPER is not set

# --- CPU frequency -------------------------------------------------------------
# Boot at full speed as the 4.4 kernel does; spruce sets its own governor.
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
# Debugfs OPP voltage tuning for overclocking: LightMoss keeps plain OPPs.
# CONFIG_ROCKCHIP_OC_TUNE is not set

# --- filesystems -------------------------------------------------------------
# Nothing on the device uses btrfs or XFS (the rootfs is ext4).
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# PortMaster ships its runtimes (Mono, LOVE, ...) as squashfs images it
# loop-mounts, some with an overlay on top.
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_OVERLAY_FS=y

# --- Wi-Fi: only the MT7601U USB dongle on the OTG port ------------------------
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=m
# CONFIG_MT76x0U is not set
# CONFIG_MT76x2U is not set
# CONFIG_WLAN_VENDOR_ADMTEK is not set
# CONFIG_WLAN_VENDOR_ATH is not set
# CONFIG_WLAN_VENDOR_ATMEL is not set
# CONFIG_WLAN_VENDOR_BROADCOM is not set
# CONFIG_WLAN_VENDOR_CISCO is not set
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_INTERSIL is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
# CONFIG_WLAN_VENDOR_MICROCHIP is not set
# CONFIG_WLAN_VENDOR_RALINK is not set
# CONFIG_WLAN_VENDOR_REALTEK is not set
# CONFIG_WLAN_VENDOR_RSI is not set
# CONFIG_WLAN_VENDOR_ST is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_WLAN_VENDOR_ZYDAS is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set
# The BSP's vendor Wi-Fi and Bluetooth drivers (arkos4clone's dongles).
# CONFIG_WL_ROCKCHIP is not set
# CONFIG_ESP8089 is not set
# CONFIG_WLAN_VENDOR_SWT6621S is not set
# CONFIG_SEEKWAVE_BSP_DRIVERS is not set
# CONFIG_R8188EU is not set
# CONFIG_USB_NET_RNDIS_WLAN is not set

# --- radios and network features the device does not have or use -------------
# CONFIG_BT is not set
# CONFIG_NFC is not set
# CONFIG_IEEE802154 is not set
# CONFIG_6LOWPAN is not set
# CONFIG_ATM is not set
# CONFIG_L2TP is not set
# CONFIG_ATALK is not set
# CONFIG_PHONET is not set
# CONFIG_RDS is not set
# CONFIG_BATMAN_ADV is not set
# CONFIG_OPENVSWITCH is not set
# CONFIG_NET_DSA is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_NETFILTER is not set
# CONFIG_NET_SCHED is not set
# CONFIG_NET_KEY is not set
# CONFIG_NET_IPIP is not set
# CONFIG_NET_IPGRE_DEMUX is not set
# CONFIG_NET_IPVTI is not set
# CONFIG_NET_FOU is not set
# CONFIG_INET_AH is not set
# CONFIG_INET_ESP is not set
# CONFIG_INET_IPCOMP is not set
# CONFIG_INET_DIAG is not set
# CONFIG_NETLINK_DIAG is not set
# CONFIG_TCP_CONG_ADVANCED is not set
# CONFIG_VSOCKETS is not set
# CONFIG_VHOST_NET is not set
# CONFIG_PPP is not set
# CONFIG_SLIP is not set
# CONFIG_NETCONSOLE is not set
# CONFIG_TUN is not set
# CONFIG_VETH is not set
# CONFIG_NLMON is not set
# CONFIG_USB_NET_DRIVERS is not set
# CONFIG_USB_SERIAL is not set
CONFIG_IPV6=y
# CONFIG_INET6_AH is not set
# CONFIG_INET6_ESP is not set
# CONFIG_INET6_IPCOMP is not set
# CONFIG_IPV6_MIP6 is not set
# CONFIG_IPV6_ILA is not set
# CONFIG_IPV6_VTI is not set
# CONFIG_IPV6_SIT is not set
# CONFIG_IPV6_TUNNEL is not set
# CONFIG_IPV6_GRE is not set
# CONFIG_MICROCHIP_PHY is not set
# CONFIG_EEPROM_93CX6 is not set
# Modules clone_defconfig's openvswitch, USB Ethernet and IPsec selected;
# their values would otherwise stay behind as =m.
# CONFIG_NET_MPLS_GSO is not set
# CONFIG_NET_NSH is not set
# CONFIG_SMSC_PHY is not set
# CONFIG_CRYPTO_AUTHENC is not set
# CONFIG_CRYPTO_SEQIV is not set
# CONFIG_CRYPTO_ECHAINIV is not set

# --- USB: no adbd or gadgets, the OTG port stays a host for the dongle ---------
# CONFIG_USB_CONFIGFS is not set
# CONFIG_USB_ETH is not set
# CONFIG_USB_G_NCM is not set
# CONFIG_USB_STORAGE is not set
# CONFIG_USB_MON is not set
# CONFIG_USB_ACM is not set
# CONFIG_USB_WDM is not set
# Webcams, and the CSI camera path the board does not have.
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_PHY_ROCKCHIP_CSI2_DPHY is not set

# --- input ------------------------------------------------------------------
# Kept: xpad and HID for external USB pads, USB audio for DACs (spruce
# supports both), and the R36S's own odroidgo3-joypad.
CONFIG_JOYSTICK_XPAD=m
CONFIG_SND_USB_AUDIO=y
# Legacy joysticks (gameport and serial), PS/2, and GPIO keys the board has none of.
# CONFIG_GAMEPORT is not set
# CONFIG_JOYSTICK_ANALOG is not set
# CONFIG_JOYSTICK_A3D is not set
# CONFIG_JOYSTICK_ADI is not set
# CONFIG_JOYSTICK_COBRA is not set
# CONFIG_JOYSTICK_GF2K is not set
# CONFIG_JOYSTICK_GRIP is not set
# CONFIG_JOYSTICK_GRIP_MP is not set
# CONFIG_JOYSTICK_GUILLEMOT is not set
# CONFIG_JOYSTICK_INTERACT is not set
# CONFIG_JOYSTICK_SIDEWINDER is not set
# CONFIG_JOYSTICK_TMDC is not set
# CONFIG_JOYSTICK_IFORCE is not set
# CONFIG_JOYSTICK_WARRIOR is not set
# CONFIG_JOYSTICK_MAGELLAN is not set
# CONFIG_JOYSTICK_SPACEORB is not set
# CONFIG_JOYSTICK_SPACEBALL is not set
# CONFIG_JOYSTICK_STINGER is not set
# CONFIG_JOYSTICK_TWIDJOY is not set
# CONFIG_JOYSTICK_ZHENHUA is not set
# CONFIG_JOYSTICK_AS5011 is not set
# CONFIG_JOYSTICK_JOYDUMP is not set
# CONFIG_KEYBOARD_ATKBD is not set
# CONFIG_KEYBOARD_XTKBD is not set
# CONFIG_KEYBOARD_GPIO is not set
# CONFIG_SERIO is not set
# CONFIG_I2C_HID is not set

# --- hardware the G80CA does not have ---------------------------------------
# No SPI flash (sfc is disabled), SPI devices, TPM or light sensors; no
# virtual machines on a handheld.
# CONFIG_MTD is not set
# CONFIG_RK_FLASH is not set
# CONFIG_SPI_ROCKCHIP is not set
# CONFIG_SPI_BITBANG is not set
# CONFIG_SPI_GPIO is not set
# CONFIG_SPI_SPIDEV is not set
# CONFIG_I2C_ARB_GPIO_CHALLENGE is not set
# CONFIG_I2C_MUX_GPIO is not set
# CONFIG_TCG_TPM is not set
# CONFIG_SENSORS_ISL29018 is not set
# CONFIG_SENSORS_TSL2563 is not set
# CONFIG_TSL2583 is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_MMC_TEST is not set
# The arkos4clone-leds driver: LightMoss's dtbs have no such node (the blue
# LED is the joypad's rumble-gpio).
# CONFIG_LEDS_ARKOS4CLONE is not set
