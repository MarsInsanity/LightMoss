menu "LightMoss"

config BR2_LIGHTMOSS_LIB32
	bool "LightMoss 32-bit (armhf) runtime build"
	depends on BR2_ARM_EABIHF && BR2_TOOLCHAIN_USES_GLIBC
	help
	  Set only in configs/lightmoss_*_lib32_defconfig: this build
	  is not an image but the armhf libraries the 64-bit image carries
	  in /usr/lib/arm-linux-gnueabihf (package lightmoss-lib32). Its
	  glibc's loader searches that directory.

config BR2_LIGHTMOSS_SDL2_VULKAN
	bool
	help
	  SDL2 built with its Vulkan support (external.mk), which
	  buildroot's sdl2 package turns off. Selected by the Vulkan
	  drivers LightMoss carries.

config BR2_LIGHTMOSS_MESA3D_TURNIP
	bool "Mesa Vulkan freedreno driver (Turnip)"
	depends on BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_FREEDRENO
	select BR2_PACKAGE_MESA3D_VULKAN_DRIVER
	select BR2_LIGHTMOSS_SDL2_VULKAN
	help
	  Mesa's Vulkan driver for Adreno GPUs (Turnip,
	  -Dvulkan-drivers=freedreno), which buildroot's mesa3d package
	  has no option for: selecting its hidden Vulkan driver symbol
	  gives mesa3d.mk the glslang host tool and the
	  -Dvulkan-drivers option, and external.mk adds freedreno to
	  it. Set only in configs/lightmoss_rpminiv2*_defconfig. The
	  Khronos loader (BR2_PACKAGE_VULKAN_LOADER) is what programs
	  link.

	source "$BR2_EXTERNAL_LIGHTMOSS_PATH/package/rk3326-mali/Config.in"
	source "$BR2_EXTERNAL_LIGHTMOSS_PATH/package/rk3326-uboot/Config.in"
	source "$BR2_EXTERNAL_LIGHTMOSS_PATH/package/lightmoss-linux510/Config.in"
	source "$BR2_EXTERNAL_LIGHTMOSS_PATH/package/hpjackd/Config.in"
	source "$BR2_EXTERNAL_LIGHTMOSS_PATH/package/lightmoss-lib32/Config.in"
	source "$BR2_EXTERNAL_LIGHTMOSS_PATH/package/sdl3/Config.in"
	source "$BR2_EXTERNAL_LIGHTMOSS_PATH/package/sdl3_image/Config.in"
	source "$BR2_EXTERNAL_LIGHTMOSS_PATH/package/sdl3_mixer/Config.in"
	source "$BR2_EXTERNAL_LIGHTMOSS_PATH/package/sdl3_ttf/Config.in"
	source "$BR2_EXTERNAL_LIGHTMOSS_PATH/package/alsa-ucm-conf/Config.in"
	source "$BR2_EXTERNAL_LIGHTMOSS_PATH/package/lightmoss-firmware-sm8250/Config.in"
	source "$BR2_EXTERNAL_LIGHTMOSS_PATH/package/openabl/Config.in"
	source "$BR2_EXTERNAL_LIGHTMOSS_PATH/package/lightmoss-volkeys/Config.in"
endmenu
